{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/rendering-v1.schema.json",
  "x-ocd-schema-version": "1.0.0",
  "title": "S2 Rendering",
  "description": "Per-engine S2 rendering contract. S2 is isolated per engine: it carries source observations, local structure, protected-character normalization, derived-span metadata, and uncertainty records without comparing engines or selecting winners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_version",
    "rendering_id",
    "engine_family",
    "engine_version",
    "source_lineage_id",
    "work_id",
    "edition_id",
    "volume",
    "pipeline_config_hash",
    "typography_snapshot_id",
    "typography_snapshot_approval_state",
    "ccel_annotation_source_id",
    "dictionary_snapshot_ids",
    "nfkc_allowlist_hash",
    "fingerprint_function_hash",
    "source_sidecar_refs",
    "parsed_keys_index_refs",
    "witness_coverage",
    "pages",
    "candidate_articles",
    "derived_spans_by_block",
    "structural_uncertainty_queue",
    "operations_ledger_ref",
    "operations_ledger_hash",
    "replay_verification",
    "admission_state"
  ],
  "properties": {
    "schema_version": {"const": "rendering-v1"},
    "stage_version": {"type": "string", "minLength": 1},
    "rendering_id": {"type": "string", "minLength": 1},
    "engine_family": {"$ref": "#/$defs/engine_family"},
    "engine_version": {"type": "string"},
    "source_lineage_id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "edition_id": {"type": "string", "minLength": 1},
    "volume": {"type": "integer", "minimum": 1},
    "pipeline_config_hash": {"$ref": "#/$defs/prefixed_sha256"},
    "typography_snapshot_id": {"type": "string", "minLength": 1},
    "typography_snapshot_approval_state": {"type": "string", "minLength": 1},
    "ccel_annotation_source_id": {"type": ["string", "null"]},
    "dictionary_snapshot_ids": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "nfkc_allowlist_hash": {"$ref": "#/$defs/prefixed_sha256"},
    "fingerprint_function_hash": {"$ref": "#/$defs/prefixed_sha256"},
    "source_sidecar_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "parsed_keys_index_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "witness_coverage": {"$ref": "#/$defs/witness_coverage"},
    "pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/rendered_page"}
    },
    "candidate_articles": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate_article"}
    },
    "derived_spans_by_block": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/$defs/derived_join_span"}
      }
    },
    "structural_uncertainty_queue": {
      "type": "array",
      "items": {"$ref": "#/$defs/structural_uncertainty"}
    },
    "operations_ledger_ref": {"$ref": "#/$defs/artifact_ref"},
    "operations_ledger_hash": {"$ref": "#/$defs/prefixed_sha256"},
    "replay_verification": {"$ref": "#/$defs/replay_verification"},
    "admission_state": {"$ref": "#/$defs/admission_state"}
  },
  "$defs": {
    "prefixed_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observation_token_id": {"type": "string", "pattern": "^ot-sha256:[0-9a-f]{64}$"},
    "derived_span_id": {"type": "string", "pattern": "^ds-sha256:[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+"
    },
    "engine_family": {
      "$comment": "Copied exactly from sidecar-manifest-v1.schema.json $defs.engine_family.",
      "type": "string",
      "enum": [
        "tesseract",
        "abbyy",
        "azure_read",
        "textract",
        "ccel",
        "surya",
        "kraken",
        "calamari"
      ]
    },
    "block_type": {
      "type": "string",
      "enum": [
        "paragraph",
        "section_heading",
        "heading_subsection",
        "bibliography_section_marker",
        "bibliography_entry",
        "cross_reference",
        "footnote",
        "caption",
        "quotation",
        "list_item",
        "table",
        "headword",
        "unknown"
      ]
    },
    "language_lane": {
      "type": "string",
      "enum": ["en", "de", "la", "grc", "hbo", "mixed", "und"]
    },
    "zone_label": {
      "type": "string",
      "enum": [
        "body",
        "running_header",
        "folio",
        "footer_text",
        "marginalia",
        "footnote",
        "caption",
        "column_rule_or_noise",
        "drop_cap",
        "unknown"
      ]
    },
    "relative_size_tier": {
      "$comment": "Small S2 value set grounded in arch2 size-tier references; arch8 may refine later.",
      "type": "string",
      "enum": ["display", "heading", "body", "small", "footnote", "unknown"]
    },
    "indent_style": {
      "$comment": "Small S2 value set grounded in arch2 indent-style references; calibrated detection is deferred.",
      "type": "string",
      "enum": ["none", "first_line", "hanging", "block", "unknown"]
    },
    "region_class": {
      "$comment": "Region class list mirrors the canonical region_class enum in matrix-events-v1.schema.json (arch4 synthesis section 1.4). Keep the two value lists identical; region_class is distinct from zone_label (locked architecture: zone_type != region_class).",
      "type": "string",
      "enum": [
        "body",
        "headword",
        "bibliography_entry",
        "bibliography_section_marker",
        "section_heading",
        "heading_subsection",
        "cross_reference",
        "footnote",
        "caption",
        "foreign_language_greek",
        "foreign_language_hebrew",
        "foreign_language_latin",
        "foreign_language_german",
        "list_item",
        "table_cell",
        "quotation",
        "unknown"
      ]
    },
    "confidence_tier": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "coverage_state": {
      "type": "string",
      "enum": ["covered", "diagnostic_only", "corrupt", "missing"]
    },
    "reading_order_reliability": {
      "type": "string",
      "enum": ["high", "medium", "low", "failed"]
    },
    "boundary_type": {
      "type": "string",
      "enum": ["line_break", "page_break", "block_break"]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/prefixed_sha256"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1},
        "unit": {"enum": ["pixel", "unknown"]}
      }
    },
    "bbox_native": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "w": {"type": "number"},
            "h": {"type": "number"}
          }
        }
      ]
    },
    "bbox_canonical": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        }
      ]
    },
    "text_layers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_raw", "normalised", "structured", "display"],
      "properties": {
        "source_raw": {"type": "string"},
        "normalised": {"type": "string"},
        "structured": {"type": "string"},
        "display": {"type": "string"}
      }
    },
    "candidate_article_membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "candidate_article_ids"],
      "properties": {
        "status": {"enum": ["none", "candidate", "member", "unknown"]},
        "candidate_article_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "bibliography_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["not_bibliography", "section_marker", "entry", "unknown"]},
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "block_type_evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "suggested_block_type", "detail"],
      "properties": {
        "evidence_type": {"type": "string"},
        "suggested_block_type": {"$ref": "#/$defs/block_type"},
        "detail": {"type": "string"}
      }
    },
    "block_type_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signals"],
      "properties": {
        "signals": {
          "type": "array",
          "items": {"$ref": "#/$defs/block_type_evidence_item"}
        }
      }
    },
    "block_type_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "suggested_block_type", "detail"],
      "properties": {
        "evidence_type": {"type": "string"},
        "suggested_block_type": {"$ref": "#/$defs/block_type"},
        "detail": {"type": "string"}
      }
    },
    "cross_reference_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_raw", "resolved"],
      "properties": {
        "target_raw": {"type": "string"},
        "resolved": {"type": "boolean"}
      }
    },
    "line_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_size", "baseline", "x_descenders", "x_ascenders"],
      "properties": {
        "x_size": {"type": ["number", "null"]},
        "baseline": {"type": ["number", "null"]},
        "x_descenders": {"type": ["number", "null"]},
        "x_ascenders": {"type": ["number", "null"]}
      }
    },
    "indent_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "block_x", "line_x"],
      "properties": {
        "style": {"$ref": "#/$defs/indent_style"},
        "block_x": {"type": ["number", "null"]},
        "line_x": {"type": ["number", "null"]}
      }
    },
    "rendered_word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_token_id",
        "native_sequence_index",
        "layers",
        "bbox_native",
        "bbox_canonical",
        "confidence_raw",
        "zone_label",
        "candidate_article_membership",
        "word_extras_carried",
        "word_extras_carried_keys",
        "word_extras_jcs_sha256",
        "in_derived_join_span",
        "derived_join_span_id"
      ],
      "properties": {
        "observation_token_id": {"$ref": "#/$defs/observation_token_id"},
        "native_sequence_index": {"type": "integer", "minimum": 0},
        "layers": {"$ref": "#/$defs/text_layers"},
        "bbox_native": {"$ref": "#/$defs/bbox_native"},
        "bbox_canonical": {"$ref": "#/$defs/bbox_canonical"},
        "confidence_raw": {"type": ["number", "null"]},
        "zone_label": {"anyOf": [{"$ref": "#/$defs/zone_label"}, {"type": "null"}]},
        "candidate_article_membership": {"$ref": "#/$defs/candidate_article_membership"},
        "word_extras_carried": {
          "type": "object",
          "additionalProperties": true
        },
        "word_extras_carried_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "word_extras_jcs_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "in_derived_join_span": {"type": ["boolean", "null"]},
        "derived_join_span_id": {
          "anyOf": [{"$ref": "#/$defs/derived_span_id"}, {"type": "null"}]
        }
      }
    },
    "rendered_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendering_line_id",
        "native_line_ids",
        "native_order",
        "derived_order",
        "bbox_native",
        "bbox_canonical",
        "line_geometry",
        "indent_evidence",
        "relative_size_tier",
        "raw_size_pt",
        "layers",
        "words",
        "line_extras_carried",
        "line_extras_carried_keys",
        "line_extras_jcs_sha256"
      ],
      "properties": {
        "rendering_line_id": {"type": "string", "minLength": 1},
        "native_line_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "native_order": {"type": "integer", "minimum": 0},
        "derived_order": {"type": "integer", "minimum": 0},
        "bbox_native": {"$ref": "#/$defs/bbox_native"},
        "bbox_canonical": {"$ref": "#/$defs/bbox_canonical"},
        "line_geometry": {"$ref": "#/$defs/line_geometry"},
        "indent_evidence": {"$ref": "#/$defs/indent_evidence"},
        "relative_size_tier": {"$ref": "#/$defs/relative_size_tier"},
        "raw_size_pt": {"type": ["number", "null"]},
        "layers": {"$ref": "#/$defs/text_layers"},
        "words": {
          "type": "array",
          "items": {"$ref": "#/$defs/rendered_word"}
        },
        "line_extras_carried": {
          "type": "object",
          "additionalProperties": true
        },
        "line_extras_carried_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "line_extras_jcs_sha256": {"$ref": "#/$defs/prefixed_sha256"}
      }
    },
    "rendered_block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendering_block_id",
        "native_block_ids",
        "native_order",
        "derived_order",
        "block_type",
        "block_type_evidence",
        "block_type_confidence",
        "block_type_conflicts",
        "region_class",
        "language_lane",
        "language_lane_confidence",
        "zone_label",
        "candidate_article_membership",
        "bibliography_layout",
        "indent_style",
        "bbox_canonical",
        "block_extras_carried",
        "block_extras_carried_keys",
        "block_extras_jcs_sha256",
        "layers",
        "lines"
      ],
      "properties": {
        "rendering_block_id": {"type": "string", "minLength": 1},
        "native_block_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "native_order": {"type": "integer", "minimum": 0},
        "derived_order": {"type": "integer", "minimum": 0},
        "block_type": {"$ref": "#/$defs/block_type"},
        "block_type_evidence": {"$ref": "#/$defs/block_type_evidence"},
        "block_type_confidence": {"$ref": "#/$defs/confidence_tier"},
        "block_type_conflicts": {
          "type": "array",
          "items": {"$ref": "#/$defs/block_type_conflict"}
        },
        "region_class": {"$ref": "#/$defs/region_class"},
        "language_lane": {"$ref": "#/$defs/language_lane"},
        "language_lane_confidence": {"$ref": "#/$defs/confidence_tier"},
        "zone_label": {"anyOf": [{"$ref": "#/$defs/zone_label"}, {"type": "null"}]},
        "candidate_article_membership": {"$ref": "#/$defs/candidate_article_membership"},
        "bibliography_layout": {"$ref": "#/$defs/bibliography_layout"},
        "indent_style": {"$ref": "#/$defs/indent_style"},
        "bbox_canonical": {"$ref": "#/$defs/bbox_canonical"},
        "block_extras_carried": {
          "type": "object",
          "additionalProperties": true
        },
        "block_extras_carried_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "block_extras_jcs_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "layers": {"$ref": "#/$defs/text_layers"},
        "lines": {
          "type": "array",
          "items": {"$ref": "#/$defs/rendered_line"}
        },
        "cross_reference_target": {"$ref": "#/$defs/cross_reference_target"}
      },
      "allOf": [
        {
          "if": {"properties": {"block_type": {"const": "cross_reference"}}},
          "then": {"required": ["cross_reference_target"]},
          "else": {"not": {"required": ["cross_reference_target"]}}
        }
      ]
    },
    "rendered_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "rendering_id",
        "page_native_id",
        "page_sequence",
        "page_dimensions_native",
        "source_payload_sha256",
        "coverage_state",
        "reading_order_reliability",
        "blocks",
        "page_extras_carried",
        "page_extras_carried_keys",
        "page_extras_jcs_sha256",
        "edition_page_key"
      ],
      "oneOf": [
        {"required": ["canonical_leaf_id"]},
        {"required": ["clid_exempt"]}
      ],
      "properties": {
        "manifest_id": {"type": "string", "minLength": 1},
        "rendering_id": {"type": "string", "minLength": 1},
        "page_native_id": {"type": "string", "minLength": 1},
        "canonical_leaf_id": {
          "type": "integer",
          "minimum": 0,
          "description": "Canonical primary-scan leaf coordinate (leaf_num), engine-agnostic and not the filename."
        },
        "edition_page_key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["section", "anchor", "ordinal"],
          "properties": {
            "section": {"enum": ["front_matter", "body", "back_matter"]},
            "anchor": {"type": "integer"},
            "ordinal": {"type": "integer", "minimum": 0}
          }
        },
        "clid_exempt": {
          "const": true,
          "description": "Set to true on a non-body / unmappable rendered page that legitimately carries no canonical_leaf_id (front/back matter, plate, recovered-gap, alternate-scan body-unrecoverable). Exactly one of canonical_leaf_id / clid_exempt is present (oneOf)."
        },
        "page_sequence": {"type": "integer", "minimum": 1},
        "page_dimensions_native": {"$ref": "#/$defs/dimensions"},
        "source_payload_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "coverage_state": {"$ref": "#/$defs/coverage_state"},
        "reading_order_reliability": {"$ref": "#/$defs/reading_order_reliability"},
        "blocks": {
          "type": "array",
          "items": {"$ref": "#/$defs/rendered_block"}
        },
        "page_extras_carried": {
          "type": "object",
          "additionalProperties": true
        },
        "page_extras_carried_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "page_extras_jcs_sha256": {"$ref": "#/$defs/prefixed_sha256"}
      }
    },
    "dictionary_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched", "resource_id", "snapshot_hash", "matched_form"],
      "properties": {
        "matched": {"type": "boolean"},
        "resource_id": {"type": "string"},
        "snapshot_hash": {"$ref": "#/$defs/prefixed_sha256"},
        "matched_form": {"type": ["string", "null"]}
      }
    },
    "derived_join_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derived_span_id",
        "operation",
        "contributor_observation_token_ids",
        "boundary_type",
        "structured_text",
        "language_lane",
        "dictionary_match",
        "candidate_window",
        "confidence_floor"
      ],
      "properties": {
        "derived_span_id": {"$ref": "#/$defs/derived_span_id"},
        "operation": {"const": "joined_continuation"},
        "contributor_observation_token_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/observation_token_id"}
        },
        "boundary_type": {"$ref": "#/$defs/boundary_type"},
        "structured_text": {"type": "string"},
        "language_lane": {"$ref": "#/$defs/language_lane"},
        "dictionary_match": {"$ref": "#/$defs/dictionary_match"},
        "candidate_window": {"type": "string"},
        "confidence_floor": {"type": ["number", "null"]}
      }
    },
    "structural_uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "reason", "rendering_block_id", "evidence"],
      "properties": {
        "queue_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "rendering_block_id": {"type": ["string", "null"]},
        "rendering_line_id": {"type": ["string", "null"]},
        "observation_token_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/observation_token_id"}
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "candidate_article": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_article_id", "rendering_block_id", "headword", "confidence"],
      "properties": {
        "candidate_article_id": {"type": "string"},
        "rendering_block_id": {"type": "string"},
        "headword": {"type": "string"},
        "confidence": {"$ref": "#/$defs/confidence_tier"}
      }
    },
    "witness_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_count",
        "eligible_pages",
        "diagnostic_pages",
        "corrupt_pages",
        "missing_pages",
        "coverage_state"
      ],
      "properties": {
        "page_count": {"type": "integer", "minimum": 0},
        "eligible_pages": {"type": "integer", "minimum": 0},
        "diagnostic_pages": {"type": "integer", "minimum": 0},
        "corrupt_pages": {"type": "integer", "minimum": 0},
        "missing_pages": {"type": "integer", "minimum": 0},
        "coverage_state": {"$ref": "#/$defs/coverage_state"}
      }
    },
    "admission_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fully_admitted",
        "coverage_gaps",
        "reading_order_low_pages",
        "reading_order_failed_pages",
        "unresolved_hyphen_count"
      ],
      "properties": {
        "fully_admitted": {"type": "boolean"},
        "coverage_gaps": {"type": "integer", "minimum": 0},
        "reading_order_low_pages": {"type": "integer", "minimum": 0},
        "reading_order_failed_pages": {"type": "integer", "minimum": 0},
        "unresolved_hyphen_count": {"type": "integer", "minimum": 0}
      }
    },
    "replay_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "ledger_schema_valid",
        "forward_replay_sha256",
        "inverse_replay_sha256",
