{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/source_manifest.schema.json",
  "x-ocd-schema-version": "4.1.0",
  "title": "Internet Archive Source Manifest",
  "description": "Per-volume manifest of IA page images. v4 adds the unified leaf-sequence shape (leaves[]); the legacy pages[]+unnumbered_leaves[] shape is accepted-but-deprecated for the migration window.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ia_item_id",
    "ia_derivative_type",
    "volume",
    "created_at"
  ],
  "properties": {
    "ia_item_id": {
      "type": "string"
    },
    "ia_derivative_type": {
      "type": "string"
    },
    "volume": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "page_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Count of numbered body leaves (page_num not null). Null retained for legacy source-cache manifests."
    },
    "leaves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/leaf_record"
      },
      "description": "v4 unified leaf-sequence shape: one record per physical leaf, sorted by leaf_num."
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page_record"
      },
      "description": "DEPRECATED (legacy shape). Removed in a future major version."
    },
    "unnumbered_leaves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unnumbered_record"
      },
      "description": "DEPRECATED (legacy shape)."
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap_record"
      }
    },
    "manifest_warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Non-blocking warnings from numbered-page mapping validation."
    }
  },
  "oneOf": [
    {
      "title": "new leaf-sequence shape",
      "required": [
        "leaves"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "pages"
            ]
          },
          {
            "required": [
              "unnumbered_leaves"
            ]
          }
        ]
      }
    },
    {
      "title": "legacy two-list shape (deprecated)",
      "required": [
        "page_count",
        "pages"
      ],
      "not": {
        "required": [
          "leaves"
        ]
      }
    }
  ],
  "$defs": {
    "leaf_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaf_num",
        "page_num",
        "kind",
        "image_state"
      ],
      "description": "One physical leaf. Provenance fields are required only when local_path is present (mirrors page_record).",
      "properties": {
        "leaf_num": {
          "type": "integer",
          "minimum": 0
        },
        "page_num": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "front_matter",
            "body",
            "plate",
            "back_matter",
            "discarded"
          ]
        },
        "image_state": {
          "type": "string",
          "enum": [
            "present",
            "pending",
            "unresolved",
            "not_imaged",
            "discarded"
          ]
        },
        "after_page_num": {
          "type": "integer",
          "minimum": 1
        },
        "blank": {
          "type": "boolean"
        },
        "discard_reason": {
          "type": "string",
          "minLength": 1
        },
        "duplicate_of_page": {
          "type": "integer",
          "minimum": 1
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "ia_leaf_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ia_filename": {
          "type": "string",
          "minLength": 1
        },
        "ia_item_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "image_mode": {
          "type": "string",
          "minLength": 1
        },
        "image_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "source_note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "local_path"
            ]
          },
          "then": {
            "required": [
              "sha256",
              "fetched_at",
              "image_mode",
              "image_size",
              "ia_leaf_id",
              "ia_filename",
              "ia_item_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "after_page_num"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "discarded"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "discard_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "body"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "page_num": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "crop_box": {
      "type": "object",
      "required": [
        "l",
        "t",
        "r",
        "b"
      ],
      "properties": {
        "l": {
          "type": "integer",
          "minimum": 0
        },
        "t": {
          "type": "integer",
          "minimum": 0
        },
        "r": {
          "type": "integer",
          "minimum": 1
        },
        "b": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_item_id",
        "source_leaf",
        "derivation",
        "crop_box",
        "replacement_reason",
        "validation_status",
        "dimension_variance"
      ],
      "properties": {
        "source_item_id": {
          "type": "string",
          "minLength": 1
        },
        "source_leaf": {
          "type": "integer",
          "minimum": 0
        },
        "derivation": {
          "type": "string",
          "enum": [
            "direct",
            "crop_2up_left",
            "crop_2up_right"
          ]
        },
        "crop_box": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/crop_box"
            }
          ]
        },
        "replacement_reason": {
          "type": "string",
          "minLength": 1
        },
        "validation_status": {
          "type": "string",
          "enum": [
            "visual_header_only",
            "bibliographic_matched",
            "text_continuity_verified"
          ]
        },
        "dimension_variance": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "derivation": {
                "const": "direct"
              }
            }
          },
          "then": {
            "properties": {
              "crop_box": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "crop_box": {
                "$ref": "#/$defs/crop_box"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "page_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_num",
        "ia_leaf_id",
        "ia_filename"
      ],
      "description": "Core fields are always required. Image/fetch fields (local_path, sha256, fetched_at, image_mode, image_size) are only required when local_path is present — entries without a downloaded JP2 image omit all five.",
      "properties": {
        "page_num": {
          "type": "integer",
          "minimum": 1
        },
        "ia_leaf_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ia_filename": {
          "type": "string",
          "minLength": 1
        },
        "ia_item_id": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "image_mode": {
          "type": "string",
          "minLength": 1
        },
        "image_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "source_note": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["ia_item_id"]
          },
          "then": {
            "required": ["provenance"]
          }
        },
        {
          "if": {
            "required": ["local_path"]
          },
          "then": {
            "required": ["sha256", "fetched_at", "image_mode", "image_size"]
          }
        }
      ]
    },
    "unnumbered_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaf_num",
        "page_num",
        "page_type",
        "section",
        "ia_leaf_id",
        "ia_filename",
        "ia_item_id",
        "local_path",
        "sha256",
        "fetched_at",
        "image_mode",
        "image_size"
      ],
      "properties": {
        "leaf_num": {
          "type": "integer",
          "minimum": 0
        },
        "page_num": {
          "type": "null"
        },
        "page_type": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "enum": [
            "front_matter",
            "back_matter"
          ]
        },
        "ia_leaf_id": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "ia_filename": {
          "type": "string",
          "minLength": 1
        },
        "ia_item_id": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "image_mode": {
          "type": "string",
          "minLength": 1
        },
        "image_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "gap_record": {
      "type": "object",
      "required": [
        "page_num",
        "status",
        "investigation_note"
      ],
      "properties": {
        "page_num": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "unresolved",
            "confirmed_absent",
            "resolved",
            "absent_from_primary_scan",
            "permanently_missing",
            "duplicate_needs_adjudication",
            "out_of_range"
          ]
        },
        "investigation_note": {
          "type": "string",
          "minLength": 1
        },
        "duplicate_leaves": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Leaf numbers a duplicate printed page was tagged on (duplicate_needs_adjudication / resolved)."
        },
        "kept_leaf": {
          "type": "integer",
          "minimum": 0,
          "description": "The leaf retained as the clean copy after duplicate adjudication."
        },
        "discarded_leaves": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Leaves dropped as misfiled duplicates after adjudication."
        },
        "resolved_from": {
          "type": "string",
          "minLength": 1,
          "description": "IA item ID of the alternate scan from which a missing body page was recovered (absent_from_primary_scan -> resolved)."
        },
        "local_path": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-root-relative image path for a recovered page that has NO primary-scan leaf (Scenario A: the primary scan skipped this printed page, so it cannot be a leaf_record). Its presence requires the image/fetch fields below; provenance carries the alternate-item audit trail."
        },
        "ia_leaf_id": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "Source (alternate) item's leaf index for the recovered image."
        },
        "ia_filename": {
          "type": "string",
          "minLength": 1
        },
        "ia_item_id": {
          "type": "string",
          "minLength": 1,
          "description": "Source IA item the recovered image came from (the alternate scan)."
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "image_mode": {
          "type": "string",
          "minLength": 1
        },
        "image_size": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "local_path"
            ]
          },
          "then": {
            "required": [
              "sha256",
              "fetched_at",
              "image_mode",
              "image_size",
              "ia_leaf_id",
              "ia_filename",
              "ia_item_id",
              "provenance"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
