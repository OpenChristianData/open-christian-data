{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/parser_anchor_fixture.schema.json",
  "x-ocd-schema-version": "3.0.0",
  "title": "Parser Anchor Fixture",
  "description": "Regression fixture for a parser's anchor algorithm. One file per parser, beside the parser module: build/parsers/<parser>.anchor_fixture.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser_id",
    "slug_algorithm_version",
    "samples"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "parser_id": {
      "type": "string",
      "description": "Parser module path, e.g. 'build/parsers/ia_schaff_herzog.py'."
    },
    "slug_algorithm_version": {
      "type": "integer",
      "minimum": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "expected_anchor"
        ],
        "properties": {
          "input": {
            "description": "Free-form input snippet used by the parser to derive the anchor.",
            "type": [
              "string",
              "object",
              "array"
            ]
          },
          "expected_anchor": {
            "type": "string",
            "description": "Fully-qualified anchor including resource_id prefix, e.g. 'schaff-herzog.theotokos'."
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
