{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/parser_anchor_remap.schema.json",
  "x-ocd-schema-version": "3.0.0",
  "title": "Parser Anchor Remap Manifest",
  "description": "Emitted when a parser version legitimately changes anchors. Consumed by the central re-key tool to migrate sidecar and ledger references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser",
    "from_version",
    "to_version",
    "slug_algorithm_version_from",
    "slug_algorithm_version_to",
    "remap",
    "orphaned"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "parser": {
      "type": "string"
    },
    "from_version": {
      "type": "string"
    },
    "to_version": {
      "type": "string"
    },
    "slug_algorithm_version_from": {
      "type": "integer",
      "minimum": 1
    },
    "slug_algorithm_version_to": {
      "type": "integer",
      "minimum": 1
    },
    "remap": {
      "type": "object",
      "description": "Map of old anchor -> new anchor. Keys and values are anchor strings.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "orphaned": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Anchors dropped by the new parser version with no replacement."
    }
  }
}
