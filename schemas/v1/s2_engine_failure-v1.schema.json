{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/s2_engine_failure-v1.schema.json",
  "x-ocd-schema-version": "1.0.0",
  "title": "S2 Engine Failure",
  "description": "Failed-engine boundary for S2 rendering. The failure_class enum is intentionally restricted to the four arch2/arch3-locked values; source payload corruption and provider-version drift remain deferred.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_version",
    "rendering_id",
    "engine_family",
    "engine_version",
    "work_id",
    "edition_id",
    "volume",
    "failure_class",
    "failed_pages",
    "passing_diagnostic_pages",
    "source_sidecar_refs",
    "ledger_ref",
    "diagnostic_hashes",
    "baseline_tier_impact",
    "s3_policy"
  ],
  "properties": {
    "schema_version": {"const": "s2_engine_failure-v1"},
    "stage_version": {"type": "string", "minLength": 1},
    "rendering_id": {"type": "string", "minLength": 1},
    "engine_family": {"$ref": "#/$defs/engine_family"},
    "engine_version": {"type": "string"},
    "work_id": {"type": "string", "minLength": 1},
    "edition_id": {"type": "string", "minLength": 1},
    "volume": {"type": "integer", "minimum": 1},
    "failure_class": {"$ref": "#/$defs/s2_failure_class"},
    "failed_pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/page_failure_ref"}
    },
    "passing_diagnostic_pages": {
      "type": "array",
      "items": {"$ref": "#/$defs/page_diagnostic_ref"}
    },
    "source_sidecar_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "ledger_ref": {
      "anyOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]
    },
    "diagnostic_hashes": {"$ref": "#/$defs/diagnostic_hashes"},
    "baseline_tier_impact": {"$ref": "#/$defs/baseline_tier_impact"},
    "s3_policy": {"$ref": "#/$defs/s3_policy"}
  },
  "$defs": {
    "prefixed_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+"
    },
    "engine_family": {
      "$comment": "Copied exactly from sidecar-manifest-v1.schema.json $defs.engine_family.",
      "type": "string",
      "enum": [
        "tesseract",
        "abbyy",
        "azure_read",
        "textract",
        "ccel",
        "surya",
        "kraken",
        "calamari"
      ]
    },
    "s2_failure_class": {
      "type": "string",
      "enum": [
        "coverage_failure",
        "reading_order_failure",
        "ledger_failure",
        "schema_failure"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/prefixed_sha256"}
      }
    },
    "page_failure_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_native_id", "page_sequence", "failure_code"],
      "properties": {
        "page_native_id": {"type": "string", "minLength": 1},
        "page_sequence": {"type": "integer", "minimum": 1},
        "failure_code": {"type": "string", "minLength": 1},
        "diagnostic_ref": {"anyOf": [{"$ref": "#/$defs/artifact_ref"}, {"type": "null"}]}
      }
    },
    "page_diagnostic_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_native_id", "page_sequence", "diagnostic_ref"],
      "properties": {
        "page_native_id": {"type": "string", "minLength": 1},
        "page_sequence": {"type": "integer", "minimum": 1},
        "diagnostic_ref": {"$ref": "#/$defs/artifact_ref"}
      }
    },
    "diagnostic_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_payload_sha256", "source_payload_sha256"],
      "properties": {
        "failure_payload_sha256": {"$ref": "#/$defs/prefixed_sha256"},
        "source_payload_sha256": {"$ref": "#/$defs/prefixed_sha256"}
      }
    },
    "baseline_tier_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_available", "tier_before", "tier_after", "reason"],
      "properties": {
        "baseline_available": {"type": "boolean"},
        "tier_before": {"type": ["string", "null"]},
        "tier_after": {"type": ["string", "null"]},
        "reason": {"type": "string"}
      }
    },
    "s3_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_for_s3", "policy_id", "reason"],
      "properties": {
        "eligible_for_s3": {"type": "boolean"},
        "policy_id": {"type": "string", "minLength": 1},
        "reason": {"type": "string"}
      }
    }
  }
}
