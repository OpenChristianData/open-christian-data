{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/field_path_remap.schema.json",
  "x-ocd-schema-version": "3.0.0",
  "title": "Field Path Remap Manifest",
  "description": "Emitted when a parser version legitimately changes the content-hash block_id (or other field-path component) of a layered field. Consumed by the central re-key tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "parser",
    "from_version",
    "to_version",
    "remap",
    "orphaned_field_paths"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "parser": {
      "type": "string"
    },
    "from_version": {
      "type": "string"
    },
    "to_version": {
      "type": "string"
    },
    "remap": {
      "type": "object",
      "description": "Map of '<entry_id>|<old_field_path>' -> '<entry_id>|<new_field_path>'.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "orphaned_field_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
