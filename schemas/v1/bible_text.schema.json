{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/bible_text.schema.json",
  "x-ocd-schema-version": "3.0.0",
  "title": "Bible Text Resource File",
  "x-ocd-default-resource-type": "bible_text",
  "description": "A verse-level Bible text resource: metadata envelope + array of verse records. One file per book.",
  "type": "object",
  "required": [
    "meta",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "language",
        "license",
        "schema_type",
        "schema_version",
        "completeness",
        "provenance",
        "scope"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable resource identifier, kebab-case."
        },
        "title": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "original_language": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]{2,3}$"
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/openchristiandata/open-christian-data/schemas/v1/_defs/contributor.schema.json"
          }
        },
        "edition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Edition or version identifier (e.g. '2nd ed. 1559', 'Second Series', '1662')."
        },
        "original_publication_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tradition": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "adventist",
              "anabaptist",
              "anglican",
              "arminian",
              "baptist",
              "brethren",
              "calvinist",
              "calvinist-methodist",
              "catholic",
              "confessional",
              "congregationalist",
              "continental-reformed",
              "dutch-reformed",
              "ecumenical",
              "evangelical",
              "free-church",
              "fundamentalist",
              "holiness",
              "jansenist",
              "lutheran",
              "mennonite",
              "methodist",
              "monastic",
              "moravian",
              "non-denominational",
              "nonconformist",
              "orthodox",
              "particular-baptist",
              "patristic",
              "pietist",
              "presbyterian",
              "puritan",
              "quaker",
              "reformed",
              "revivalist",
              "salvation-army",
              "scholastic",
              "wesleyan"
            ]
          },
          "minItems": 1
        },
        "tradition_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": "string",
          "enum": [
            "cc0-1.0",
            "cc-by-4.0",
            "cc-by-sa-4.0",
            "public-domain"
          ]
        },
        "schema_type": {
          "type": "string",
          "const": "bible_text"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "completeness": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "in-progress"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_url",
            "source_format",
            "source_edition",
            "download_date",
            "source_hash",
            "processing_method",
            "processing_script_version",
            "processing_date"
          ],
          "additionalProperties": false,
          "properties": {
            "source_url": {
              "type": "string"
            },
            "source_format": {
              "type": "string"
            },
            "source_edition": {
              "type": "string"
            },
            "download_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "source_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "processing_method": {
              "type": "string",
              "enum": [
                "manual",
                "automated",
                "automated-with-review",
                "ocr",
                "ocr-with-review"
              ]
            },
            "processing_script_version": {
              "type": "string"
            },
            "processing_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "scope": {
          "type": "object",
          "description": "Book identity for this file. All records in data[] belong to this book.",
          "required": [
            "book",
            "book_osis",
            "book_number"
          ],
          "additionalProperties": false,
          "properties": {
            "book": {
              "type": "string",
              "description": "Full canonical English book name."
            },
            "book_osis": {
              "type": "string",
              "description": "OSIS book code, e.g. Gen, Ps, Rev."
            },
            "book_number": {
              "type": "integer",
              "minimum": 1,
              "maximum": 82,
              "description": "Canonical Bible book order (1=Genesis, 66=Revelation; 67+ for apocrypha/deuterocanon books when present in a source canon)."
            }
          }
        }
      }
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "osis",
          "chapter",
          "verse",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "osis": {
            "type": "string",
            "description": "OSIS verse reference, e.g. Gen.1.1",
            "pattern": "^[0-9]?[A-Z][a-zA-Z0-9]+\\.\\d+\\.\\d+$"
          },
          "chapter": {
            "type": "integer",
            "minimum": 1
          },
          "verse": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Verse text, whitespace-trimmed."
          },
          "word_count": {
            "type": "integer",
            "minimum": 0
          },
          "token_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
