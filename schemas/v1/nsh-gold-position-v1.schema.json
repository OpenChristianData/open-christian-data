{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/nsh-gold-position-v1.schema.json",
  "x-ocd-schema-version": "1.0.0",
  "title": "NSH Gold Position",
  "description": "One human-adjudicated word-position truth record for NSH gold sampling.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "page_image_sha256",
    "bbox",
    "edition_page_key",
    "volume",
    "crop_ref",
    "stratum",
    "script",
    "token_class",
    "baseline_candidates",
    "review_status"
  ],
  "properties": {
    "schema_version": {"const": "nsh-gold-position-v1"},
    "page_image_sha256": {"$ref": "#/$defs/prefixed_sha256"},
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "number", "minimum": 0},
        "y": {"type": "number", "minimum": 0},
        "w": {"type": "number", "minimum": 0},
        "h": {"type": "number", "minimum": 0}
      }
    },
    "edition_page_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "anchor", "ordinal"],
      "properties": {
        "section": {"type": "string"},
        "anchor": {"type": "integer", "minimum": 0},
        "ordinal": {"type": "integer", "minimum": 0}
      }
    },
    "volume": {"type": "integer", "minimum": 1},
    "canonical_leaf_id": {"type": ["integer", "null"]},
    "position_id": {"type": "string", "minLength": 1},
    "derived_observation_token_ids": {
      "type": "array",
      "items": {"$ref": "#/$defs/ot_token_id"}
    },
    "context_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left_reading": {"type": ["string", "null"]},
        "right_reading": {"type": ["string", "null"]}
      }
    },
    "crop_ref": {"$ref": "#/$defs/relative_path"},
    "stratum": {"enum": ["greek_hebrew", "degraded", "dense", "clean"]},
    "script": {"enum": ["latin", "greek", "hebrew", "mixed", "other"]},
    "token_class": {"enum": ["proper_name", "number", "date", "scripture_ref", "greek", "hebrew", "none"]},
    "baseline_candidates": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    },
    "alternate_candidates": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    },
    "prefilled_true_reading": {"type": ["string", "null"]},
    "review_status": {"enum": ["pending", "verified", "unverifiable"]},
    "true_reading": {"type": ["string", "null"]},
    "unverifiable_reason": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "timestamp", "source_basis"],
      "properties": {
        "actor_id": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "source_basis": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "verified"}}},
      "then": {
        "required": ["true_reading", "provenance"],
        "properties": {
          "true_reading": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    },
    {
      "if": {"properties": {"review_status": {"const": "unverifiable"}}},
      "then": {
        "required": ["true_reading", "unverifiable_reason", "provenance"],
        "properties": {
          "true_reading": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "prefixed_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+"
    },
    "ot_token_id": {"type": "string", "pattern": "^ot-sha256:[0-9a-f]{64}$"}
  }
}
