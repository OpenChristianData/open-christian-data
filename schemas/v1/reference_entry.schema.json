{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/reference_entry.schema.json",
  "x-ocd-schema-version": "3.0.0",
  "title": "Reference Entry Resource File",
  "x-ocd-default-resource-type": "encyclopedia",
  "description": "A structured Bible dictionary or encyclopedia resource: metadata envelope + array of term entries. Covers Easton's, Smith's, and Hitchcock's. NOT Torrey's (see topical_reference.schema.json).",
  "type": "object",
  "required": [
    "meta",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "author",
        "original_publication_year",
        "language",
        "tradition",
        "license",
        "schema_type",
        "schema_version",
        "completeness",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable resource identifier, kebab-case."
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "author_birth_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "author_death_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/openchristiandata/open-christian-data/schemas/v1/_defs/contributor.schema.json"
          }
        },
        "original_publication_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "edition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Edition or version identifier (e.g. '2nd ed. 1559', 'Second Series', '1662')."
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "tradition": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "adventist",
              "anabaptist",
              "anglican",
              "arminian",
              "baptist",
              "brethren",
              "calvinist",
              "calvinist-methodist",
              "catholic",
              "confessional",
              "congregationalist",
              "continental-reformed",
              "dutch-reformed",
              "ecumenical",
              "evangelical",
              "free-church",
              "fundamentalist",
              "holiness",
              "jansenist",
              "lutheran",
              "mennonite",
              "methodist",
              "monastic",
              "moravian",
              "non-denominational",
              "nonconformist",
              "orthodox",
              "particular-baptist",
              "patristic",
              "pietist",
              "presbyterian",
              "puritan",
              "quaker",
              "reformed",
              "revivalist",
              "salvation-army",
              "scholastic",
              "wesleyan"
            ]
          },
          "minItems": 1
        },
        "tradition_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": "string",
          "enum": [
            "cc0-1.0",
            "public-domain",
            "cc-by-4.0",
            "cc-by-sa-4.0"
          ]
        },
        "schema_type": {
          "type": "string",
          "const": "reference_entry"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "resource_type": {
          "type": "string",
          "description": "Override the schema default resource type."
        },
        "text_layer_shape": {
          "type": "string",
          "enum": [
            "multi_field"
          ],
          "description": "Text layer layout for entries in this resource."
        },
        "scan_storage": {
          "type": "string",
          "enum": [
            "external_url",
            "git_lfs"
          ],
          "description": "How scan images are stored for this resource. external_url is the default; git_lfs is opt-in. Required when any entry.scan_source is populated; optional otherwise."
        },
        "completeness": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "in-progress"
          ]
        },
        "coverage": {
          "type": "object",
          "required": [
            "strategy",
            "parameters"
          ],
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "entry_inventory",
                "none"
              ]
            },
            "intent": {
              "type": "string",
              "enum": [
                "exhaustive",
                "selective",
                "thematic"
              ]
            },
            "parameters": {
              "type": "object"
            }
          },
          "oneOf": [
            {
              "properties": {
                "strategy": {
                  "const": "entry_inventory"
                },
                "parameters": {
                  "type": "object",
                  "required": [
                    "expected_entry_count_range",
                    "alphabetical_completeness"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "expected_entry_count_range": {
                      "type": "object",
                      "required": [
                        "value",
                        "provenance"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "value": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "integer",
                              "minimum": 0
                            },
                            {
                              "type": "integer",
                              "minimum": 0
                            }
                          ],
                          "items": false,
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "provenance": {
                          "$ref": "#/$defs/coverage_parameter_provenance"
                        }
                      }
                    },
                    "alphabetical_completeness": {
                      "type": "object",
                      "required": [
                        "expected_letters",
                        "provenance"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "expected_letters": {
                          "type": "string",
                          "minLength": 1
                        },
                        "provenance": {
                          "$ref": "#/$defs/coverage_parameter_provenance"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "properties": {
                "strategy": {
                  "const": "none"
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false
                }
              }
            }
          ],
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_url",
            "source_format",
            "source_edition",
            "download_date",
            "source_hash",
            "processing_method",
            "processing_script_version",
            "processing_date"
          ],
          "additionalProperties": false,
          "properties": {
            "source_url": {
              "type": "string"
            },
            "source_format": {
              "type": "string"
            },
            "source_edition": {
              "type": "string"
            },
            "download_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "source_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "processing_method": {
              "type": "string",
              "enum": [
                "manual",
                "automated",
                "automated-with-review",
                "ocr",
                "ocr-with-review"
              ]
            },
            "processing_script_version": {
              "type": "string"
            },
            "processing_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "dictionary_id",
          "term",
          "definition_blocks",
          "word_count"
        ],
        "additionalProperties": false,
        "properties": {
          "entry_id": {
            "type": "string",
            "description": "Stable unique identifier: {dictionary-id}.{term-slug}"
          },
          "dictionary_id": {
            "type": "string",
            "description": "Kebab-case dictionary identifier, e.g. eastons-bible-dictionary."
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "description": "Headword as it appears in the dictionary."
          },
          "alt_terms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Alternative forms or spellings. SKOS altLabel pattern."
          },
          "definition_blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Paragraph array from source. Each element is one block of definition text."
          },
          "scripture_references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "raw",
                "osis"
              ],
              "additionalProperties": false,
              "properties": {
                "raw": {
                  "type": "string",
                  "description": "Reference as it appears in the source."
                },
                "osis": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Normalized OSIS. May be empty if unparseable."
                }
              }
            },
            "description": "Extracted scripture references. Empty in initial pipeline pass; populated during enrichment."
          },
          "related_terms": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Cross-referenced terms within the same dictionary. SKOS related pattern."
          },
          "word_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Total word count across all definition_blocks."
          },
          "layers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "term": {
                "$ref": "#/$defs/text_layer_entry"
              },
              "alt_terms": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/text_layer_entry"
                }
              },
              "definition_blocks": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/text_layer_entry"
                }
              }
            }
          },
          "scan_source": {
            "$ref": "#/$defs/scan_source"
          }
        }
      }
    }
  },
  "$defs": {
    "scan_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume", "page", "manifest_path"],
      "properties": {
        "volume": {
          "type": ["string", "integer"]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "manifest_path": {
          "type": "string",
          "description": "Path to the resource's scans_manifest.json, e.g. 'sources/<resource>/scans_manifest.json'."
        }
      },
      "description": "Per-entry pointer into the resource's scans_manifest. Populated by parsers whose source data carries coordinates. Renderer skips silently when absent."
    },
    "text_layer_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_raw",
        "normalised",
        "structured",
        "display",
        "source_raw_origin"
      ],
      "properties": {
        "source_raw": {
          "type": "string"
        },
        "normalised": {
          "type": "string"
        },
        "structured": {
          "type": "string"
        },
        "display": {
          "type": "string"
        },
        "source_raw_origin": {
          "type": "string",
          "enum": [
            "observed",
            "unavailable",
            "reconstructed"
          ]
        }
      }
    },
    "coverage_parameter_provenance": {
      "type": "object",
      "required": [
        "source",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "config",
            "source_metadata",
            "generated_inventory"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
