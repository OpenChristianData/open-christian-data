{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/ocr-inventory-v1.schema.json",
  "x-ocd-schema-version": "1.0.0",
  "title": "OCR Inventory",
  "description": "Derived read-only inventory of OCR coverage across S1, S2, and legacy witness stores. Leaf number lists contain canonical_leaf_id values: the primary-scan leaf_num coordinate. extra_leaf_nums are leaves beyond the current body denominator, including front/back-matter that is OCR-eligible later as a migration target, not a terminal state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "generator",
    "work_id",
    "edition_id",
    "volumes",
    "by_lineage",
    "witnesses"
  ],
  "properties": {
    "schema_version": {"const": "ocr-inventory-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": {"const": "build/tools/ocr_pipeline/ocr_inventory.py"},
        "version": {"const": "v1"}
      }
    },
    "work_id": {"const": "schaff-herzog-encyclopedia"},
    "edition_id": {"const": "1908-1914"},
    "volumes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/volume_entry"}
    },
    "by_lineage": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/lineage_entry"}
    },
    "witnesses": {
      "type": "array",
      "items": {"$ref": "#/$defs/witness"}
    },
    "errors": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+"
    },
    "int_list": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "volume_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominator", "cells", "stage_summary"],
      "properties": {
        "denominator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_ocr_body_leaves", "source_manifest"],
          "properties": {
            "expected_ocr_body_leaves": {"type": "integer", "minimum": 0},
            "source_manifest": {"$ref": "#/$defs/relative_path"}
          }
        },
        "cells": {
          "type": "array",
          "items": {"$ref": "#/$defs/cell"}
        },
        "stage_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["s1", "s2"],
          "properties": {
            "s1": {"$ref": "#/$defs/stage_summary"},
            "s2": {"$ref": "#/$defs/stage_summary"}
          }
        }
      }
    },
    "stage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineages_present"],
      "properties": {
        "lineages_present": {"type": "integer", "minimum": 0}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "source_lineage_id",
        "engine_family",
        "rendering_id",
        "expected",
        "present",
        "covered",
        "missing_count",
        "extra_count",
        "failed",
        "key_style",
        "unresolved",
        "covered_leaf_nums",
        "covered_leaf_nums_truncated",
        "missing_leaf_nums",
        "missing_leaf_nums_truncated",
        "extra_leaf_nums",
        "extra_leaf_nums_truncated",
        "cell"
      ],
      "properties": {
        "stage": {"type": "string", "enum": ["s1", "s2"]},
        "source_lineage_id": {"type": "string", "minLength": 1},
        "engine_family": {"type": "string"},
        "rendering_id": {"type": "string"},
        "expected": {"type": "integer", "minimum": 0},
        "present": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "missing_count": {"type": "integer", "minimum": 0},
        "extra_count": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "key_style": {"type": "string", "enum": ["leaf", "page", "mixed", "none"]},
        "unresolved": {
          "type": "array",
          "items": {"type": "string"}
        },
        "covered_leaf_nums": {
          "$ref": "#/$defs/int_list",
          "description": "Canonical primary-scan leaf coordinates (leaf_num) covered by this cell."
        },
        "covered_leaf_nums_truncated": {"type": "boolean"},
        "missing_leaf_nums": {"$ref": "#/$defs/int_list"},
        "missing_leaf_nums_truncated": {"type": "boolean"},
        "extra_leaf_nums": {
          "$ref": "#/$defs/int_list",
          "description": "Canonical primary-scan leaf coordinates (leaf_num) beyond the current body denominator; front/back-matter here is OCR-eligible later as a migration target, not terminal."
        },
        "extra_leaf_nums_truncated": {"type": "boolean"},
        "s2_lag": {"type": "integer", "minimum": 0},
        "cell": {"$ref": "#/$defs/relative_path"}
      }
    },
    "lineage_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_family", "volumes_s1", "volumes_s2"],
      "properties": {
        "engine_family": {"type": "string"},
        "volumes_s1": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "volumes_s2": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store", "path", "volume", "note"],
      "properties": {
        "store": {"type": "string", "enum": ["legacy_gen1", "legacy_unnormalized"]},
        "path": {"$ref": "#/$defs/relative_path"},
        "volume": {"type": "integer", "minimum": 1},
        "note": {"type": "string"}
      }
    }
  }
}
