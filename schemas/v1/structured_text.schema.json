{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/structured_text.schema.json",
  "x-ocd-schema-version": "3.0.0",
  "title": "Structured Text Resource File",
  "x-ocd-default-resource-type": "structured_text",
  "description": "A hierarchical prose work: metadata envelope + recursive section tree. Covers theological works, devotional classics, treatises, and catechism-prose.",
  "type": "object",
  "required": [
    "meta",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "author",
        "language",
        "tradition",
        "license",
        "schema_type",
        "schema_version",
        "completeness",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable resource identifier, kebab-case."
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "author_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Canonical author ID from author registry."
        },
        "author_birth_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "author_death_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/openchristiandata/open-christian-data/schemas/v1/_defs/contributor.schema.json"
          }
        },
        "original_publication_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "edition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Edition or version identifier (e.g. '2nd ed. 1559', 'Second Series', '1662')."
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "original_language": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z]{2,3}$"
        },
        "tradition": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "adventist",
              "anabaptist",
              "anglican",
              "arminian",
              "baptist",
              "brethren",
              "calvinist",
              "calvinist-methodist",
              "catholic",
              "confessional",
              "congregationalist",
              "continental-reformed",
              "dutch-reformed",
              "ecumenical",
              "evangelical",
              "free-church",
              "fundamentalist",
              "holiness",
              "jansenist",
              "lutheran",
              "mennonite",
              "methodist",
              "monastic",
              "moravian",
              "non-denominational",
              "nonconformist",
              "orthodox",
              "particular-baptist",
              "patristic",
              "pietist",
              "presbyterian",
              "puritan",
              "quaker",
              "reformed",
              "revivalist",
              "salvation-army",
              "scholastic",
              "wesleyan"
            ]
          },
          "minItems": 1
        },
        "tradition_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "era": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "apostolic",
            "patristic",
            "medieval",
            "reformation",
            "post-reformation",
            "modern",
            null
          ]
        },
        "audience": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "scholarly",
            "pastoral",
            "lay",
            "children",
            null
          ]
        },
        "license": {
          "type": "string",
          "enum": [
            "cc0-1.0",
            "cc-by-4.0",
            "cc-by-sa-4.0",
            "public-domain"
          ]
        },
        "schema_type": {
          "type": "string",
          "const": "structured_text"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "completeness": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "abridged",
            "in-progress"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_url",
            "source_format",
            "source_edition",
            "download_date",
            "source_hash",
            "processing_method",
            "processing_script_version",
            "processing_date"
          ],
          "additionalProperties": false,
          "properties": {
            "source_url": {
              "type": "string"
            },
            "source_format": {
              "type": "string"
            },
            "source_edition": {
              "type": "string"
            },
            "download_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "source_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "processing_method": {
              "type": "string",
              "enum": [
                "manual",
                "automated",
                "automated-with-review",
                "ocr",
                "ocr-with-review"
              ]
            },
            "processing_script_version": {
              "type": "string"
            },
            "processing_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            },
            "source_type": {
              "type": [
                "string",
                "null"
              ],
              "description": "Source format type identifier (e.g. 'ccel_thml', 'gutenberg_txt')."
            },
            "source_file": {
              "type": [
                "string",
                "null"
              ],
              "description": "Relative path to the cached raw source file (e.g. 'raw/ccel/npnf1/npnf101.xml')."
            },
            "translator": {
              "type": [
                "string",
                "null"
              ],
              "description": "Translator name and year (e.g. 'Philip Schaff (ed.), 1886')."
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "work_id",
        "work_kind",
        "sections"
      ],
      "additionalProperties": false,
      "description": "The work as a recursive section tree.",
      "properties": {
        "work_id": {
          "type": "string",
          "description": "Kebab-case work identifier."
        },
        "work_kind": {
          "type": "string",
          "enum": [
            "theological-work",
            "catechism-prose",
            "treatise",
            "devotional-classic",
            "systematic-theology",
            "church-history",
            "martyrology"
          ]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": [
        "raw",
        "osis"
      ],
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": "string"
        },
        "osis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "section_type"
      ],
      "additionalProperties": false,
      "description": "A recursive section node. Leaf nodes have content_blocks; branch nodes have children.",
      "properties": {
        "section_type": {
          "type": "string",
          "enum": [
            "book",
            "part",
            "chapter",
            "section",
            "subsection",
            "letter",
            "preface",
            "introduction",
            "conclusion",
            "appendix"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source label, e.g. 'Book I', 'Part II'."
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Section title."
        },
        "content_blocks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paragraphs (leaf nodes). Empty array for branch nodes."
        },
        "scripture_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "word_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Word count for this section (content_blocks only, not children)."
        },
        "boundary_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "description": "Confidence in a source-derived section boundary locator."
        },
        "token_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Token count using cl100k_base. Computed at build time."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    }
  }
}
