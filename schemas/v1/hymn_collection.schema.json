{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/hymn_collection.schema.json",
  "x-ocd-schema-version": "3.0.0",
  "title": "Hymn Collection File",
  "x-ocd-default-resource-type": "hymn_collection",
  "description": "A collection of public-domain hymns: metadata envelope + array of individual hymn records.",
  "type": "object",
  "required": [
    "meta",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "title",
        "language",
        "tradition",
        "license",
        "schema_type",
        "schema_version",
        "completeness",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable resource identifier, kebab-case."
        },
        "title": {
          "type": "string"
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/openchristiandata/open-christian-data/schemas/v1/_defs/contributor.schema.json"
          }
        },
        "edition": {
          "type": [
            "string",
            "null"
          ],
          "description": "Edition or version identifier (e.g. '2nd ed. 1559', 'Second Series', '1662')."
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}$"
        },
        "tradition": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "adventist",
              "anabaptist",
              "anglican",
              "arminian",
              "baptist",
              "brethren",
              "calvinist",
              "calvinist-methodist",
              "catholic",
              "confessional",
              "congregationalist",
              "continental-reformed",
              "dutch-reformed",
              "ecumenical",
              "evangelical",
              "free-church",
              "fundamentalist",
              "holiness",
              "jansenist",
              "lutheran",
              "mennonite",
              "methodist",
              "monastic",
              "moravian",
              "non-denominational",
              "nonconformist",
              "orthodox",
              "particular-baptist",
              "patristic",
              "pietist",
              "presbyterian",
              "puritan",
              "quaker",
              "reformed",
              "revivalist",
              "salvation-army",
              "scholastic",
              "wesleyan"
            ]
          },
          "minItems": 1
        },
        "tradition_notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": "string",
          "enum": [
            "cc0-1.0",
            "cc-by-4.0",
            "cc-by-sa-4.0",
            "public-domain"
          ]
        },
        "schema_type": {
          "type": "string",
          "const": "hymn_collection"
        },
        "schema_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "completeness": {
          "type": "string",
          "enum": [
            "full",
            "partial",
            "in-progress"
          ]
        },
        "provenance": {
          "type": "object",
          "required": [
            "source_url",
            "source_format",
            "source_edition",
            "download_date",
            "source_hash",
            "processing_method",
            "processing_script_version",
            "processing_date"
          ],
          "additionalProperties": false,
          "properties": {
            "source_url": {
              "type": "string"
            },
            "source_format": {
              "type": "string"
            },
            "source_edition": {
              "type": "string"
            },
            "download_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "source_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "processing_method": {
              "type": "string",
              "enum": [
                "manual",
                "automated",
                "automated-with-review",
                "ocr",
                "ocr-with-review"
              ]
            },
            "processing_script_version": {
              "type": "string"
            },
            "processing_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "entry_id",
          "collection_id",
          "title",
          "stanzas",
          "language",
          "word_count"
        ],
        "additionalProperties": false,
        "properties": {
          "entry_id": {
            "type": "string",
            "description": "Unique kebab-case identifier within the collection."
          },
          "collection_id": {
            "type": "string",
            "description": "Kebab-case collection identifier."
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": [
              "string",
              "null"
            ],
            "description": "Author name as provided by the source. May contain multiple authors separated by semicolons, and birth/death years."
          },
          "author_birth_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "author_death_year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "year_written": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Year the hymn was written or composed, if known."
          },
          "stanzas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Hymn text split into stanzas. Each stanza is a single string with internal line breaks preserved."
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}$",
            "description": "ISO 639-1/2 language code. 'en' for English; 'mul' when the detected language is non-English or mixed."
          },
          "hymnal_title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Title of the oldest known public-domain hymnal containing this text."
          },
          "hymnal_year": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Publication year of the oldest known PD hymnal instance."
          },
          "word_count": {
            "type": "integer",
            "minimum": 0
          },
          "token_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Token count using cl100k_base. Computed at build time."
          }
        }
      }
    }
  }
}
