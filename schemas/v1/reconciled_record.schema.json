{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/reconciled_record.schema.json",
  "x-ocd-schema-version": "3.0.0",
  "title": "Reconciled Record",
  "description": "A work-edition's reconciled block sequence produced by the Reconcile stage. Two-level attestation: block-level coverage (attested_by) and chosen-reading-level agreement (disagreements). Original-spelling config; paired with a modernised sibling when modernisation applies.",
  "type": "object",
  "required": ["meta", "blocks", "match_explanations"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "$ref": "#/$defs/record_meta",
      "properties": {
        "schema_type": {
          "const": "reconciled_record"
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {"$ref": "#/$defs/block"}
    },
    "match_explanations": {
      "type": "array",
      "items": {"$ref": "#/$defs/match_explanation"}
    }
  },
  "$defs": {
    "record_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "author_slug",
        "author_display_name",
        "author_birth_year",
        "author_death_year",
        "original_publication_year",
        "language",
        "tradition",
        "license",
        "schema_type",
        "schema_version",
        "edition",
        "pd_anchor",
        "modernisation_ruleset_version",
        "attestation_summary"
      ],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "author_slug": {"type": "string"},
        "author_display_name": {"type": "string"},
        "author_birth_year": {"type": ["integer", "null"]},
        "author_death_year": {"type": ["integer", "null"]},
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "https://github.com/openchristiandata/open-christian-data/schemas/v1/_defs/contributor.schema.json"
          }
        },
        "original_publication_year": {"type": ["integer", "null"]},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "tradition": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "adventist", "anabaptist", "anglican", "arminian", "baptist",
              "brethren", "calvinist", "calvinist-methodist", "catholic",
              "confessional", "congregationalist", "continental-reformed",
              "dutch-reformed", "ecumenical", "evangelical", "free-church",
              "fundamentalist", "holiness", "jansenist", "lutheran",
              "mennonite", "methodist", "monastic", "moravian",
              "non-denominational", "nonconformist", "orthodox",
              "particular-baptist", "patristic", "pietist", "presbyterian",
              "puritan", "quaker", "reformed", "revivalist",
              "salvation-army", "scholastic", "wesleyan"
            ]
          }
        },
        "license": {
          "type": "string",
          "enum": [
            "public-domain", "cc0-1.0", "cc-by-4.0", "cc-by-sa-4.0",
            "cc-by", "cc-by-sa", "cc-by-nc", "cc-by-nd", "cc-by-nc-nd",
            "cc-by-nc-sa", "restricted", "all-rights-reserved"
          ]
        },
        "schema_type": {"type": "string"},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "edition": {"type": "string"},
        "pd_anchor": {"type": "string"},
        "modernisation_ruleset_version": {"type": ["string", "null"]},
        "attestation_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block_count",
            "fully_attested_blocks",
            "blocks_with_disagreements",
            "blocks_with_structural_disagreements"
          ],
          "properties": {
            "block_count": {"type": "integer", "minimum": 0},
            "fully_attested_blocks": {"type": "integer", "minimum": 0},
            "blocks_with_disagreements": {"type": "integer", "minimum": 0},
            "blocks_with_structural_disagreements": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "block_id_history",
        "block_type",
        "language",
        "language_confidence",
        "language_alternates",
        "language_segments",
        "original_text",
        "modern_text",
        "annotations",
        "source_pages",
        "attested_by",
        "disagreements",
        "structural_disagreements",
        "modernisations"
      ],
      "properties": {
        "block_id": {"type": "string"},
        "block_id_history": {"type": "array", "items": {"type": "string"}},
        "block_type": {
          "type": "string",
          "enum": [
            "paragraph", "heading", "lemma", "list_item", "footnote",
            "verse_line", "headword", "quote", "table_row"
          ]
        },
        "language": {"type": "string", "pattern": "^[a-z]{2,8}$"},
        "language_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "language_alternates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["language", "confidence"],
            "properties": {
              "language": {"type": "string"},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            },
            "additionalProperties": false
          }
        },
        "language_segments": {
          "type": "array",
          "items": {"$ref": "#/$defs/language_segment"}
        },
        "original_text": {"type": "string"},
        "modern_text": {"type": "string"},
        "annotations": {"type": "object"},
        "source_pages": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_page"}
        },
        "attested_by": {
          "type": "array",
          "description": "Rendering_ids (canonical or short alias) that attest this block. Aliases resolvable via the work catalog's aliases field.",
          "items": {"type": "string"}
        },
        "disagreements": {
          "type": "array",
          "items": {"$ref": "#/$defs/disagreement"}
        },
        "structural_disagreements": {
          "type": "array",
          "items": {"$ref": "#/$defs/structural_disagreement"}
        },
        "modernisations": {
          "type": "array",
          "items": {"$ref": "#/$defs/modernisation"}
        },
        "canonical_positions": {
          "type": "array",
          "description": "Per-position canonical reading metadata for machine-composed corrector output. Existing block-only records may omit this until the corrector path emits it.",
          "items": {"$ref": "#/$defs/canonical_position"}
        }
      }
    },
    "canonical_position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_id",
        "canonical_text",
        "canonical_derivation_level",
        "canonical_origin_kind"
      ],
      "properties": {
        "position_id": {"type": "string"},
        "canonical_text": {"type": "string"},
        "canonical_derivation_level": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "L3"]
        },
        "canonical_origin_kind": {
          "type": "string",
          "enum": ["observed", "machine_composed", "human_amended"]
        },
        "character_provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/character_provenance_entry"}
        }
      }
    },
    "character_provenance_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grapheme", "source_type", "source_id"],
      "properties": {
        "grapheme": {"type": "string", "minLength": 1},
        "source_type": {
          "type": "string",
          "enum": [
            "engine_family",
            "confusion_rule",
            "lexicon",
            "language_model",
            "human"
          ]
        },
        "source_id": {"type": "string"},
        "wct_candidate_id": {"type": "string"},
        "wct_span_record_id": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "language_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span", "language", "original_script", "transliteration"],
      "properties": {
        "span": {
          "type": "object",
          "required": ["start_token", "end_token"],
          "additionalProperties": false,
          "properties": {
            "start_token": {"type": "integer", "minimum": 0},
            "end_token": {"type": "integer", "minimum": 0}
          }
        },
        "language": {"type": "string"},
        "original_script": {"type": "string"},
        "transliteration": {"type": "string"},
        "transliterated_from": {"type": "string"}
      }
    },
    "source_page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rendering_id", "page_number"],
      "properties": {
        "rendering_id": {
          "type": "string",
          "description": "Canonical rendering_id or short alias (e.g. ccel-thml, ia-ocr). Aliases are resolvable via the work catalog's aliases field."
        },
        "page_number": {"type": ["integer", "null"]},
        "bbox": {
          "type": "object",
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "width": {"type": "number"},
            "height": {"type": "number"}
          }
        }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": true,
      "required": ["span", "kind", "chosen_reading", "chosen_reading_attested_by"],
      "properties": {
        "span": {
          "type": "object",
          "required": ["start_token", "end_token"],
          "properties": {
            "start_token": {"type": "integer", "minimum": 0},
            "end_token": {"type": "integer", "minimum": 0}
          }
        },
        "kind": {"type": "string"},
        "chosen_reading": {"type": "string"},
        "chosen_reading_attested_by": {"type": "array", "items": {"type": "string"}},
        "match_explanation_id": {"type": "string"}
      }
    },
    "structural_disagreement": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "neighbour_merged_in_source",
            "block_split_in_source",
            "block_missing_in_source",
            "heading_extra_in_source",
            "heading_missing_in_source",
            "block_type_conflict_in_source",
            "annotation_chunking_disagreement",
            "unclassified"
          ]
        },
        "match_explanation_id": {"type": "string"}
      }
    },
    "modernisation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rule_id", "span", "original", "modern"],
      "properties": {
        "rule_id": {"type": ["string", "null"]},
        "rule_version": {"type": "string"},
        "kind": {"type": "string", "enum": ["editorial"]},
        "editor_decision": {
          "type": "object",
          "required": ["rationale", "decided_at"],
          "properties": {
            "rationale": {"type": "string"},
            "decided_at": {"type": "string", "format": "date-time"}
          }
        },
        "span": {
          "type": "object",
          "required": ["start_token", "end_token"],
          "properties": {
            "start_token": {"type": "integer", "minimum": 0},
            "end_token": {"type": "integer", "minimum": 0}
          }
        },
        "original": {"type": "string"},
        "modern": {"type": "string"}
      }
    },
    "match_explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_explanation_id", "scope", "signals", "total_score", "decision"],
      "properties": {
        "match_explanation_id": {"type": "string"},
        "scope": {
          "type": "string",
          "enum": ["block_pair_edge", "disagreement", "structural_disagreement"]
        },
        "block_id": {"type": "string"},
        "block_id_pair": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
        "signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "raw_score", "weight", "contribution"],
            "properties": {
              "name": {"type": "string"},
              "raw_score": {"type": "number"},
              "weight": {"type": "number"},
              "contribution": {"type": "number"}
            }
          }
        },
        "total_score": {"type": "number"},
        "decision": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "bucket", "score_range", "action", "surface"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "edge_match"},
                "bucket": {"type": "string"},
                "score_range": {"type": "string"},
                "action": {"type": "string"},
                "surface": {"type": "string"}
              }
            },
            {
              "type": "object",
              "required": ["kind", "pd_only_gap", "winning_has_pd_support", "classification", "advisory_score"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "reading_score"},
                "pd_only_gap": {"type": "number"},
                "winning_has_pd_support": {"type": "boolean"},
                "classification": {"type": "string"},
                "advisory_score": {"type": "number"}
              }
            },
            {
              "type": "object",
              "required": ["kind", "rule_applied", "outcome"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "structural_rule"},
                "rule_applied": {"type": "string"},
                "outcome": {"type": "string"}
              }
            }
          ]
        }
      }
    }
  }
}
