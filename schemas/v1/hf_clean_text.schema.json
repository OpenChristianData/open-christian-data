{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/hf_clean_text.schema.json",
  "x-ocd-schema-version": "1.0.0",
  "title": "HuggingFace clean-text projection row",
  "type": "object",
  "required": [
    "id",
    "work_id",
    "rendering_id",
    "title_path",
    "argument",
    "text",
    "language",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "work_id": {"type": "string", "minLength": 1},
    "rendering_id": {"type": "string", "minLength": 1},
    "title_path": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "argument": {"type": ["string", "null"]},
    "text": {"type": "string"},
    "language": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["author", "translator", "source_url", "license"],
      "additionalProperties": false,
      "properties": {
        "author": {"type": "string"},
        "translator": {"type": "string"},
        "source_url": {"type": "string"},
        "license": {"type": "string", "minLength": 1}
      }
    },
    "speeches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["speaker", "text", "char_start", "char_end"],
        "additionalProperties": false,
        "properties": {
          "speaker": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "text": {"type": "string", "minLength": 1},
          "char_start": {"type": "integer", "minimum": 0},
          "char_end": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
