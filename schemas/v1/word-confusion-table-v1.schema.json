{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/word-confusion-table-v1.schema.json",
  "x-ocd-schema-version": "1.0.0",
  "title": "Word Confusion Table (Layer-1 / S2.5)",
  "description": "Layer-1 alignment artifact: one confusion table per page image. Per-engine span records (split/merge/skip/insertion), not boolean votes; no truth selection, context scoring, or calibration fitting inside Layer 1. Field names and enum literals follow the locked arch A alignment contract verbatim, with three explicit amendments: schema_version is a versioned const (was draft-step-a placeholder); source_image is a {path, sha256} object (was a flat string); each SpanRecord carries a first-class span_record_id. SEMANTIC-VALIDATOR OBLIGATION: pure JSON Schema cannot bind segmentation_relation to token_span_type. The invariant (skip=>gap, exact=>1:1, split=>1:n, merge=>n:1, insertion=>1:1) is enforced by build/lib/wct_semantic_validator.py and covered by tests, not by a JSON Schema keyword.",
  "type": "object",
  "required": [
    "schema_type",
    "schema_version",
    "work_id",
    "volume_id",
    "page_id",
    "source_image",
    "coordinate_unit",
    "coordinate_frame",
    "image_size",
    "layout_authority",
    "available_engines",
    "zones",
    "reading_order",
    "positions",
    "layer1_ops",
    "edition_page_key"
  ],
  "additionalProperties": false,
  "oneOf": [
    {"required": ["canonical_leaf_id"]},
    {"required": ["clid_exempt"]}
  ],
  "properties": {
    "schema_type": {"const": "word_confusion_table"},
    "schema_version": {"const": "word-confusion-table-v1"},
    "work_id": {"type": "string"},
    "volume_id": {"type": "string"},
    "page_id": {"type": "string"},
    "canonical_leaf_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Canonical primary-scan leaf coordinate (leaf_num), engine-agnostic and not the filename."
    },
    "edition_page_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "anchor", "ordinal"],
      "properties": {
        "section": {"enum": ["front_matter", "body", "back_matter"]},
        "anchor": {"type": "integer"},
        "ordinal": {"type": "integer", "minimum": 0}
      }
    },
    "clid_exempt": {
      "const": true,
      "description": "Set to true on a non-body / unmappable WCT page that legitimately carries no canonical_leaf_id (recovered-gap, non-body, 1:N duplicate-sha). Exactly one of canonical_leaf_id / clid_exempt is present (oneOf)."
    },
    "source_image": {
      "type": "object",
      "description": "Amendment 2: object {path, sha256} for replay integrity (was a flat string in the arch A draft).",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path to the source page image (repo-root relative; never an absolute home path)."
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "coordinate_unit": {
      "type": "string",
      "description": "Unit of all bbox coordinates on this page (arch A: \"pixel\")."
    },
    "coordinate_frame": {
      "type": "string",
      "description": "Frame all bboxes are expressed in (arch A: \"source_image\"). ABBYY page_size is normalised into this frame at ingest."
    },
    "image_size": {
      "type": "array",
      "description": "[width, height] in pixels. Read from any engine carrying image_size; ABBYY page_size:{width,height} is normalised at ingest.",
      "items": {"type": "integer"},
      "minItems": 2,
      "maxItems": 2
    },
    "layout_authority": {
      "type": "object",
      "required": ["tool", "model_version", "status"],
      "additionalProperties": false,
      "properties": {
        "tool": {"$ref": "#/$defs/layout_tool"},
        "model_version": {"type": "string"},
        "status": {"type": "string"}
      }
    },
    "available_engines": {
      "type": "array",
      "description": "Engines that RAN on this page (S0 integrity gate). An absent engine is in neither available_engines nor any span record; absent is not a skip.",
      "items": {"$ref": "#/$defs/engine_ref"}
    },
    "zones": {
      "type": "array",
      "description": "Reversible zone labels (mark, never strip).",
      "items": {"$ref": "#/$defs/zone"}
    },
    "reading_order": {
      "type": "array",
      "description": "Body-track position_ids, two-column resolved.",
      "items": {"type": "string"}
    },
    "positions": {
      "type": "array",
      "items": {"$ref": "#/$defs/position"}
    },
    "layer1_ops": {
      "type": "array",
      "description": "Replay / provenance ledger. Entry shape is owned by the L1 implementation (S9); minimal core fixed here.",
      "items": {"$ref": "#/$defs/op"}
    },
    "page_extras_carried": {
      "type": "object",
      "description": "Lossless passthrough for unknown upstream page-level fields (arch3 2.2.4 pattern). The _keys / _jcs_sha256 siblings belong to the deferred arch3 hashing pass.",
      "additionalProperties": true
    }
  },
  "$defs": {
    "wct_zone_type": {
      "type": "string",
      "enum": [
        "body",
        "footnote",
        "running-header",
        "page-number",
        "figure",
        "marginalia",
        "bibliography"
      ]
    },
    "token_span_type": {
      "type": "string",
      "enum": ["exact", "split", "merge", "skip", "insertion"]
    },
    "segmentation_relation": {
      "type": "string",
      "enum": ["1:1", "1:n", "n:1", "gap"]
    },
    "hyphenation_status": {
      "type": "string",
      "enum": ["none", "soft-linebreak", "hard-hyphen", "ambiguous"]
    },
    "script_label": {
      "type": "string",
      "enum": ["latin", "greek", "hebrew", "coptic", "mixed", "unknown"]
    },
    "script_routing": {
      "type": "string",
      "enum": ["normal-latin", "non-latin-review", "biblical-language-lane"]
    },
    "normalisation_op": {
      "type": "string",
      "enum": [
        "unicode_nfkc",
        "ligature_expand",
        "hyphen_unjoined_key",
        "caps_casefold"
      ]
    },
    "conf_agg": {
      "type": "string",
      "enum": ["min", "single", "none"]
    },
    "layout_tool": {
      "type": "string",
      "enum": ["surya", "docint-role", "geometric"]
    },
    "zone_source": {
      "type": "string",
      "enum": ["surya", "docint-role", "geometric"]
    },
    "engine_family": {
      "type": "string",
      "description": "Observational/extensible (maintainer q2). surya, kraken, calamari added now; further families via ADR + regen, no v2 bump. Still rejects unlisted values.",
      "enum": [
        "abbyy",
        "tesseract",
        "azure-ai-vision",
        "google-cloud-vision",
        "aws-textract",
        "surya",
        "kraken",
        "calamari"
      ]
    },
    "bbox": {
      "type": "object",
      "description": "Source-image pixel-frame bounding box.",
      "required": ["x", "y", "w", "h"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"},
        "w": {"type": "number"},
        "h": {"type": "number"}
      }
    },
    "polygon_point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number"},
        "y": {"type": "number"}
      }
    },
    "engine_ref": {
      "type": "object",
      "required": [
        "engine_id",
        "family",
        "lineage",
        "engine_version",
        "engine_run_id"
      ],
      "additionalProperties": false,
      "properties": {
        "engine_id": {"type": "string"},
        "family": {"$ref": "#/$defs/engine_family"},
        "lineage": {"type": "string"},
        "scan_id": {"type": "string"},
        "engine_version": {"type": "string"},
        "engine_run_id": {"type": "string"}
      }
    },
    "zone": {
      "type": "object",
      "required": ["zone_id", "zone_type", "track_id", "column", "polygon", "source"],
      "additionalProperties": false,
      "properties": {
        "zone_id": {"type": "string"},
        "zone_type": {"$ref": "#/$defs/wct_zone_type"},
        "track_id": {"type": "string"},
        "column": {"type": ["integer", "null"]},
        "polygon": {
          "type": "array",
          "items": {"$ref": "#/$defs/polygon_point"}
        },
        "source": {"$ref": "#/$defs/zone_source"}
      }
    },
    "op": {
      "type": "object",
      "required": ["op_id", "stage"],
      "additionalProperties": false,
      "properties": {
        "op_id": {"type": "string"},
        "stage": {"type": "string"},
        "tool": {"type": "string"},
        "detail": {"type": "string"},
        "op_extras_carried": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "source_span": {
      "type": "object",
      "required": ["token_id", "text", "bbox", "line_id"],
      "additionalProperties": false,
      "properties": {
        "token_id": {"type": "string"},
        "text": {"type": "string"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "bbox_polygon": {
          "type": "array",
          "items": {"$ref": "#/$defs/polygon_point"}
        },
        "line_id": {"type": "string"}
      }
    },
    "candidate": {
      "type": "object",
      "description": "A distinct real reading. candidate_set holds real readings only; a skip is a span record, never a candidate. raw_reading / candidate_key are non-null.",
      "required": [
        "candidate_id",
        "raw_reading",
        "candidate_key",
        "normalisation_applied",
        "attesting_engines",
        "attesting_families"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_id": {"type": "string"},
        "raw_reading": {"type": "string"},
        "candidate_key": {"type": "string"},
        "normalisation_applied": {
          "type": "array",
          "items": {"$ref": "#/$defs/normalisation_op"}
        },
        "attesting_engines": {
          "type": "array",
          "items": {"type": "string"}
        },
        "attesting_families": {
          "type": "array",
          "items": {"$ref": "#/$defs/engine_family"}
        }
      }
    },
    "span_record": {
      "type": "object",
      "description": "One per attesting engine. token_span_type carries the categorical (exact/split/merge/skip/insertion); segmentation_relation carries the cardinality and MUST agree per the semantic-validator invariant. For a skip: candidate_id null, empty source_spans, raw_confidence null, raw_text/normalized_text/visual_distance_to_candidate omitted.",
      "required": [
        "engine_id",
        "family",
        "lineage",
        "candidate_id",
        "token_span_type",
        "segmentation_relation",
        "source_spans",
        "raw_confidence",
        "calibrated_confidence",
        "raw_confidence_aggregation",
        "span_record_id"
      ],
      "additionalProperties": false,
      "properties": {
        "span_record_id": {
          "type": "string",
          "description": "Amendment 3: first-class span id. The reconciled-v1 attestation links the exact span via wct_span_record_id."
        },
        "engine_id": {"type": "string"},
        "family": {"$ref": "#/$defs/engine_family"},
        "lineage": {"type": "string"},
        "scan_id": {"type": "string"},
        "engine_version": {"type": "string"},
        "engine_run_id": {"type": "string"},
        "candidate_id": {
          "type": ["string", "null"],
          "description": "Which candidate this engine attests; null for a skip."
        },
        "token_span_type": {"$ref": "#/$defs/token_span_type"},
        "segmentation_relation": {"$ref": "#/$defs/segmentation_relation"},
        "raw_text": {"type": "string"},
        "normalized_text": {"type": "string"},
        "was_normalized": {"type": "boolean"},
        "source_spans": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_span"}
        },
        "raw_confidence": {
          "type": ["number", "null"],
          "description": "Engine-native scale (NOT cross-engine comparable). null for a skip."
        },
        "calibrated_confidence": {
          "type": ["number", "null"],
          "description": "Reserved; filled by Layer 2. null in Layer-1 bootstrap (PIPE-14: schema allows the field before any data carries it)."
        },
        "visual_distance_to_candidate": {"type": "number"},
        "raw_confidence_aggregation": {"$ref": "#/$defs/conf_agg"}
      }
    },
    "position_zone": {
      "type": "object",
      "required": [
        "zone_id",
        "zone_type",
        "track_id",
        "column",
        "line_id",
        "line_order",
        "position_order"
      ],
      "additionalProperties": false,
      "properties": {
        "zone_id": {"type": "string"},
        "zone_type": {"$ref": "#/$defs/wct_zone_type"},
        "track_id": {"type": "string"},
        "column": {"type": ["integer", "null"]},
        "line_id": {"type": "string"},
        "line_order": {"type": "integer"},
        "position_order": {"type": "integer"}
      }
    },
    "hyphenation_evidence": {
      "type": "object",
      "required": ["engine", "token_ids", "raw_tokens"],
      "additionalProperties": false,
      "properties": {
        "engine": {"type": "string"},
        "token_ids": {"type": "array", "items": {"type": "string"}},
        "raw_tokens": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hyphenation": {
      "type": "object",
      "required": ["hyphenation_status", "raw_line_break_evidence", "hypothesis_ids"],
      "additionalProperties": false,
      "properties": {
        "hyphenation_status": {"$ref": "#/$defs/hyphenation_status"},
        "raw_line_break_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/hyphenation_evidence"}
        },
        "hypothesis_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "script_image_level": {
      "type": "object",
      "required": ["label", "confidence", "method"],
      "additionalProperties": false,
      "properties": {
        "label": {"$ref": "#/$defs/script_label"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "string"}
      }
    },
    "script_text_level": {
      "type": "object",
      "required": ["label", "method"],
      "additionalProperties": false,
      "properties": {
        "label": {"$ref": "#/$defs/script_label"},
        "method": {"type": "string"}
      }
    },
    "script": {
      "type": "object",
      "required": ["image_level", "text_level", "routing"],
      "additionalProperties": false,
      "properties": {
        "image_level": {"$ref": "#/$defs/script_image_level"},
        "text_level": {"$ref": "#/$defs/script_text_level"},
        "routing": {"$ref": "#/$defs/script_routing"}
      }
    },
    "position": {
      "type": "object",
      "required": [
        "position_id",
        "zone",
        "reference_bbox",
        "reference_bbox_source",
        "hyphenation",
        "script",
        "candidate_set",
        "span_records",
        "available_engines",
        "comparable_engines",
        "unassigned_engines",
        "alignment_confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "position_id": {"type": "string"},
        "zone": {"$ref": "#/$defs/position_zone"},
        "reference_bbox": {"$ref": "#/$defs/bbox"},
        "reference_bbox_source": {"type": "string"},
        "hyphenation": {"$ref": "#/$defs/hyphenation"},
        "hyphenation_hypothesis_group": {"type": ["string", "null"]},
        "script": {"$ref": "#/$defs/script"},
        "candidate_set": {
          "type": "array",
          "description": "DISTINCT real readings only - NO null entries.",
          "items": {"$ref": "#/$defs/candidate"}
        },
        "span_records": {
          "type": "array",
          "items": {"$ref": "#/$defs/span_record"}
        },
        "available_engines": {
          "type": "array",
          "description": "Inherits the page-level set as engine_id references; coverage denominator.",
          "items": {"type": "string"}
        },
        "comparable_engines": {"type": "array", "items": {"type": "string"}},
        "unassigned_engines": {"type": "array", "items": {"type": "string"}},
        "alignment_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "ONE per position - slot-membership confidence, not truth. Per-span alignment_confidence is rejected by additionalProperties:false on span_record."
        },
        "position_extras_carried": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
