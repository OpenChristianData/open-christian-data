{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openchristiandata/open-christian-data/schemas/v1/sidecar-page-v1.schema.json",
  "x-ocd-schema-version": "1.0.0",
  "title": "S1 Sidecar Page",
  "description": "S1 per-page sidecar record for normalized engine output. The page carries observed blocks, lines, words, parsed-key handling, page-level extras, and the source payload hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "rendering_id",
    "page_native_id",
    "page_sequence",
    "page_dimensions_native",
    "blocks",
    "parsed_keys_index",
    "page_extras_carried",
    "page_extras_carried_keys",
    "page_extras_jcs_sha256",
    "source_payload_sha256",
    "edition_page_key"
  ],
  "oneOf": [
    {"required": ["canonical_leaf_id"]},
    {"required": ["clid_exempt"]}
  ],
  "properties": {
    "schema_version": {"const": "sidecar-page-v1"},
    "manifest_id": {"type": "string", "minLength": 1},
    "rendering_id": {"type": "string", "minLength": 1},
    "page_native_id": {"type": "string", "minLength": 1},
    "canonical_leaf_id": {
      "type": "integer",
      "minimum": 0,
      "description": "Canonical primary-scan leaf coordinate (leaf_num), engine-agnostic and not the filename."
    },
    "edition_page_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "anchor", "ordinal"],
      "properties": {
        "section": {"enum": ["front_matter", "body", "back_matter"]},
        "anchor": {"type": "integer"},
        "ordinal": {"type": "integer", "minimum": 0}
      }
    },
    "clid_exempt": {
      "const": true,
      "description": "Set to true on a non-body / unmappable page that legitimately carries no canonical_leaf_id (front/back matter, plate, recovered-gap, alternate-scan body-unrecoverable). Exactly one of canonical_leaf_id / clid_exempt is present (oneOf)."
    },
    "page_sequence": {"type": "integer", "minimum": 1},
    "page_dimensions_native": {"$ref": "#/$defs/dimensions"},
    "blocks": {
      "type": "array",
      "items": {"$ref": "#/$defs/observed_block"}
    },
    "parsed_keys_index": {
      "type": "array",
      "items": {"$ref": "#/$defs/parsed_key"}
    },
    "page_extras_carried": {
      "type": "object",
      "additionalProperties": true
    },
    "page_extras_carried_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "page_extras_jcs_sha256": {"$ref": "#/$defs/prefixed_sha256"},
    "source_payload_sha256": {"$ref": "#/$defs/prefixed_sha256"}
  },
  "$defs": {
    "prefixed_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observation_token_id": {"type": "string", "pattern": "^ot-sha256:[0-9a-f]{64}$"},
    "handling_enum": {
      "type": "string",
      "enum": ["extras_carried", "diagnostic_only"]
    },
    "bbox_native": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "w", "h"],
          "properties": {
            "x": {"type": "number"},
            "y": {"type": "number"},
            "w": {"type": "number"},
            "h": {"type": "number"}
          }
        }
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": {"type": ["integer", "null"], "minimum": 1},
        "height": {"type": ["integer", "null"], "minimum": 1},
        "unit": {"enum": ["pixel", "unknown"]}
      }
    },
    "observed_word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_token_id",
        "word_native_id",
        "source_raw",
        "confidence",
        "bbox_native"
      ],
      "properties": {
        "observation_token_id": {"$ref": "#/$defs/observation_token_id"},
        "word_native_id": {"type": "string", "minLength": 1},
        "source_raw": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "bbox_native": {"$ref": "#/$defs/bbox_native"}
      }
    },
    "observed_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_token_id",
        "line_native_id",
        "source_raw",
        "confidence",
        "bbox_native",
        "words"
      ],
      "properties": {
        "observation_token_id": {"$ref": "#/$defs/observation_token_id"},
        "line_native_id": {"type": "string", "minLength": 1},
        "source_raw": {"type": "string"},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "bbox_native": {"$ref": "#/$defs/bbox_native"},
        "words": {
          "type": "array",
          "items": {"$ref": "#/$defs/observed_word"}
        }
      }
    },
    "observed_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "block_type", "lines", "bbox_native"],
      "properties": {
        "block_id": {"type": "string", "minLength": 1},
        "block_type": {"enum": ["text", "diagnostic"]},
        "lines": {
          "type": "array",
          "items": {"$ref": "#/$defs/observed_line"}
        },
        "bbox_native": {"$ref": "#/$defs/bbox_native"}
      }
    },
    "parsed_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "handling", "source_path"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "handling": {"$ref": "#/$defs/handling_enum"},
        "source_path": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    }
  }
}
