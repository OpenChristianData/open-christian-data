{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocd://schemas/v2/lead-migration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "ocd-lead-migration-v1"
    },
    "migration_id": {
      "type": "string",
      "pattern": "^lead-repair-[0-9a-f]{16}$"
    },
    "queue_before": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "claims_before": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "manifest_current": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "research/MANIFEST.md"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lines": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "sha256",
        "lines"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lead_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "unchanged",
              "moved",
              "changed_claim_hold",
              "ambiguous_claim_hold",
              "unresolved_claim_hold",
              "added"
            ]
          },
          "old_claim_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "history_evidence": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line_end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "line_start",
                  "line_end"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_evidence": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line_end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "line_start",
                  "line_end"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "current_observation_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "current_evidence": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "line_start": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "line_end": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "path",
                  "sha256",
                  "line_start",
                  "line_end"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "current_claim_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "lead_id",
          "status",
          "old_claim_sha256",
          "history_evidence",
          "previous_evidence",
          "current_observation_id",
          "current_evidence",
          "current_claim_sha256"
        ]
      }
    },
    "historical_basis": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "contract",
    "migration_id",
    "queue_before",
    "claims_before",
    "manifest_current",
    "entries",
    "historical_basis"
  ],
  "title": "OCD immutable lead migration and conservation evidence"
}
