{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocd://schemas/v2/metadata-labels.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "languages",
    "providers",
    "roles",
    "authorities",
    "formats"
  ],
  "properties": {
    "version": {
      "const": "ocd-metadata-labels-v2"
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorities": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "formats": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "description"
        ],
        "properties": {
          "kind": {
            "const": "provider-set"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "format_descriptions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "representations"
        ],
        "properties": {
          "representations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "format",
                "encoding",
                "packaging",
                "production"
              ],
              "properties": {
                "format": {
                  "type": "string",
                  "minLength": 1
                },
                "encoding": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "packaging": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "production": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "ocr",
                    "transcription",
                    "extracted-text",
                    null
                  ]
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "uniqueItems": true,
            "minItems": 1
          }
        }
      }
    }
  }
}
