{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocd://schemas/v2/categories/prayers.schema.json",
  "x-ocd-profile": {
    "version": "ocd-prayers-bounded-v4",
    "elements": {
      "TEI": [
        "teiHeader",
        "text"
      ],
      "teiHeader": [
        "fileDesc"
      ],
      "fileDesc": [
        "titleStmt",
        "publicationStmt",
        "sourceDesc"
      ],
      "titleStmt": [
        "title"
      ],
      "title": [],
      "publicationStmt": [
        "p"
      ],
      "sourceDesc": [
        "bibl"
      ],
      "bibl": [
        "title",
        "note"
      ],
      "note": [
        "seg",
        "ref"
      ],
      "text": [
        "body"
      ],
      "body": [
        "div"
      ],
      "div": [
        "head",
        "p",
        "ab",
        "note"
      ],
      "head": [],
      "p": [
        "hi",
        "ref"
      ],
      "label": [],
      "ab": [
        "label",
        "hi",
        "ref"
      ],
      "hi": [],
      "ref": [
        "hi"
      ],
      "seg": [
        "hi"
      ]
    },
    "attributes": {
      "div": [
        "type",
        "xml:id"
      ],
      "title": [
        "type"
      ],
      "head": [
        "type"
      ],
      "note": [
        "type"
      ],
      "ab": [
        "type",
        "xml:id",
        "corresp"
      ],
      "hi": [
        "rend"
      ],
      "ref": [
        "type",
        "cRef",
        "target"
      ],
      "seg": [
        "type"
      ]
    },
    "roles": {
      "header": "header-context-outside-prayer-body",
      "text": "mapped",
      "typography": "typography-in-readable-text"
    },
    "renditions": [
      "bold",
      "italic"
    ]
  },
  "title": "Prayer units and structured prayer anthologies",
  "description": "Bounded petition/response prayers or source-native anthology units, each independently accounted.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "textual_form_id",
        "edition_id",
        "record_id",
        "sequence",
        "language",
        "text",
        "representation_revision",
        "provenance",
        "category",
        "locator",
        "office",
        "occasion",
        "rubrics",
        "divisions"
      ],
      "properties": {
        "work_id": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/work_id"
        },
        "textual_form_id": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/textual_form_id"
        },
        "edition_id": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/edition_id"
        },
        "record_id": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/record_id"
        },
        "sequence": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/sequence"
        },
        "language": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/language"
        },
        "text": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/text"
        },
        "representation_revision": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/representation_revision"
        },
        "provenance": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/provenance"
        },
        "category": {
          "const": "prayers"
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "title"
          ],
          "properties": {
            "kind": {
              "const": "prayer"
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "office": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "occasion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "rubrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "divisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text",
              "speaker",
              "response_to"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "paragraph",
                  "petition",
                  "response"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "speaker": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "response_to": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "raw"
                  ],
                  "properties": {
                    "raw": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "cRef": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "scripture": {
                      "$ref": "ocd://schemas/v2/public-row.schema.json#/$defs/explicit_scripture_target"
                    },
                    "normalization_attribute": {
                      "enum": [
                        "cRef",
                        "target"
                      ]
                    },
                    "normalization_status": {
                      "enum": [
                        "explicit-target-syntax",
                        "unsupported-explicit-target",
                        "no-explicit-target"
                      ]
                    }
                  }
                }
              }
            }
          },
          "minItems": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_id",
        "textual_form_id",
        "edition_id",
        "record_id",
        "sequence",
        "language",
        "text",
        "representation_revision",
        "provenance",
        "category",
        "content_format",
        "structure",
        "locator"
      ],
      "properties": {
        "work_id": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/work_id"
        },
        "textual_form_id": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/textual_form_id"
        },
        "edition_id": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/edition_id"
        },
        "record_id": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/record_id"
        },
        "sequence": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/sequence"
        },
        "language": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/language"
        },
        "text": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/text"
        },
        "representation_revision": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/representation_revision"
        },
        "provenance": {
          "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/provenance"
        },
        "category": {
          "const": "prayers"
        },
        "content_format": {
          "const": "ocd-native-content-v1"
        },
        "structure": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "ocd://schemas/v2/native-content.schema.json"
          }
        },
        "locator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text_part",
            "unit"
          ],
          "properties": {
            "kind": {
              "const": "native-unit"
            },
            "text_part": {
              "enum": [
                "front",
                "body",
                "back"
              ]
            },
            "unit": {
              "type": "integer",
              "minimum": 1
            },
            "document": {
              "type": "integer",
              "minimum": 1,
              "description": "Ordered TEI member position within a composed edition."
            }
          }
        }
      }
    }
  ]
}
