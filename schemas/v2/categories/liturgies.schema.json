  "properties": {
    "work_id": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/work_id"
    },
    "textual_form_id": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/textual_form_id"
    },
    "edition_id": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/edition_id"
    },
    "record_id": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/record_id"
    },
    "sequence": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/sequence"
    },
    "category": {
      "const": "liturgies"
    },
    "language": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/language"
    },
    "text": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/text"
    },
    "representation_revision": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/representation_revision"
    },
    "provenance": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/provenance"
    },
    "notes": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/notes"
    },
    "references": {
      "$ref": "ocd://schemas/v2/public-row.schema.json#/properties/references"
    },
    "service_id": {
      "type": "string",
      "minLength": 1
    },
    "service_title": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "step_kind": {
      "enum": [
        "speech",
        "rubric",
        "alternative",
        "branch",
        "instruction",
        "text"
      ]
    },
    "sequence_in_service": {
      "type": "integer",
      "minimum": 1
    },
    "speaker": {
      "type": "string",
      "minLength": 1
    },
    "response_to": {
      "type": "string",
      "minLength": 1
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_type"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "text"
        ],
        "properties": {
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "row_profile": {
      "enum": [
        "ocd-liturgies-n18328-offices-v1",
        "ocd-liturgies-bcp1662-retained-members-v1",
        "ocd-liturgies-bcp1549-retained-members-v1",
        "ocd-liturgies-bcp1559-retained-members-v1",
        "ocd-liturgies-chrysostom-1866-retained-members-v1"
      ]
    },
    "office_id": {
      "type": "string",
      "minLength": 1
    },
    "office_number": {
      "type": "integer",
      "minimum": 1
    },
    "office_title": {
      "type": "string",
      "minLength": 1
    },
    "response_model": {
      "enum": [
        "ordered-source-speeches-without-explicit-links",
        "literal-role-annotations-without-person-or-response-links",
        "source-native-labels-without-response-inference"
      ]
    },
    "content_format": {
      "const": "ocd-native-content-v1"
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "ocd://schemas/v2/native-content.schema.json"
      }
    },
    "front_matter": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "ocd://schemas/v2/native-content.schema.json"
      }
    },
    "locator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text_part",
            "part_titles",
            "divisions",
            "service",
            "step"
          ],
          "properties": {
            "kind": {
              "const": "liturgy-step"
            },
            "text_part": {
              "enum": [
                "front",
                "body",
                "back"
              ]
            },
            "part_titles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "divisions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "order",
                  "type",
                  "titles"
                ],
                "properties": {
                  "order": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "titles": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "service": {
              "type": "integer",
              "minimum": 1
            },
            "step": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text_part",
            "outer_division",
            "office"
          ],
          "properties": {
            "kind": {
              "const": "liturgy-office"
            },
            "text_part": {
              "const": "body"
            },
            "outer_division": {
              "const": 1
            },
            "office": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "text_part",
            "member",
            "member_kind"
          ],
          "properties": {
            "kind": {
              "const": "liturgy-member"
            },
            "text_part": {
              "const": "body"
            },
            "member": {
              "type": "integer",
              "minimum": 1,
              "maximum": 34
            },
            "member_kind": {
              "enum": [
                "service",
                "calendar-part",
                "source-member"
              ]
            }
          }
        }
      ]
    },
    "member_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{20}$"
    },
    "member_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 34
    },
    "member_title": {
      "type": "string",
      "minLength": 1
    },
    "member_kind": {
      "enum": [
        "service",
        "calendar-part",
        "source-member"
      ]
    },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "targets"
        ],
        "properties": {
          "kind": {
            "enum": [
              "continuation",
              "alternative"
            ]
          },
          "path": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "token",
                "path"
              ],
              "properties": {
                "token": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{20}$"
                },
                "path": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "x-ocd-profile": {
    "version": "ocd-liturgies-tei-profile-v1",
    "unit_type": "service",
    "tei_namespace": "http://www.tei-c.org/ns/1.0",
    "allowed_elements": [
      "TEI",
