      "sourceDesc",
      "source",
      "ptr",
      "idno",
      "text",
      "front",
      "body",
      "back",
      "div",
      "head",
      "label",
      "p",
      "sp",
      "speaker",
      "stage",
      "choice",
      "seg",
      "note",
      "hi",
      "foreign",
      "ref",
      "lb",
      "pb"
    ],
    "step_kinds": [
      "speech",
      "rubric",
      "alternative",
      "branch",
      "instruction",
      "text"
    ],
    "branch_type": "branch",
    "alternative_type": "alternative"
  }
