<TEI xmlns="http://www.tei-c.org/ns/1.0" xml:id="kjv-genesis"><teiHeader><fileDesc><titleStmt><title>King James Version — Genesis 1:1–3</title></titleStmt><publicationStmt><p>Fixture-only source-bound Bible extract.</p></publicationStmt><sourceDesc><bibl><title>King James Version</title><ptr target="ocd-source:raw/bible_databases/formats/json/KJV.json"/><idno type="sha256">f0b09dc49dfb97bb84f03aae1fbf026485048c3cab31a7a41017e2d86ac1d11c</idno><idno type="source_sha256">f0b09dc49dfb97bb84f03aae1fbf026485048c3cab31a7a41017e2d86ac1d11c</idno><idno type="work_id">bible-genesis</idno><idno type="textual_form_id">bible-english</idno><idno type="edition_id">kjv</idno><idno type="representation_revision">bible-fixture-v1</idno><idno type="versification">source-native:KJV.json</idno><note type="source-location">raw/bible_databases/formats/json/KJV.json</note><note type="source-scope">Genesis chapter 1, verses 1, 2, 3</note></bibl></sourceDesc></fileDesc></teiHeader><text><body><div type="book" n="Genesis" xml:id="Gen"><div type="chapter" n="1" xml:id="Gen.1"><ab type="verse" n="1" xml:id="Gen.1.1">In the beginning God created the heaven and the earth.</ab><ab type="verse" n="2" xml:id="Gen.1.2">And the earth was without form and void; and darkness was upon the face of the deep. And the Spirit of God moved upon the face of the waters.</ab><ab type="verse" n="3" xml:id="Gen.1.3">And God said, Let there be light: and there was light.</ab></div></div></body></text></TEI>