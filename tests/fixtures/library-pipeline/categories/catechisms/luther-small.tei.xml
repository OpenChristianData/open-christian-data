      <div type="part" n="I" xml:id="luther-part-1">
        <head>The Ten Commandments</head>
        <div type="chapter" xml:id="luther-chapter-1">
          <head>The First Commandment</head>
          <div type="question" xml:id="luther-q-1">
            <head type="question">What does this mean?</head>
            <ab type="answer">We must fear, love, and trust God more than anything else.</ab>
          </div>
        </div>
        <div type="chapter" xml:id="luther-chapter-2">
          <head>The Second Commandment</head>
          <div type="question" xml:id="luther-q-2">
            <head type="question">What does this mean?</head>
            <ab type="answer">We must fear and love God, so that we will not use His name to curse, swear, cast a spell, lie or deceive, but will use it to call upon Him, pray to Him, praise Him and thank Him in all times of trouble.</ab>
          </div>
        </div>
      </div>
