run_remote_ocr.cmd

# OS
.DS_Store
Thumbs.db

# Node (for future TypeScript tooling)
node_modules/
raw/

# Git worktrees
.worktrees/

# Graphify intermediate build cache (AST + semantic analysis artifacts)
graphify-out/cache/

# Claude Code local config. Durable project context belongs in Git, but
# machine-local settings still stay out.
# Narrowed 2026-05-07 to allow committed .claude/rules, .claude/skills, .claude/settings.json
.claude/CLAUDE.md
.claude/settings.local.json
build/temp/

# Pipeline-generated reports (regenerable: run the tool to rebuild)
# S0 ingest bijection (run_s0_ingest.py), engine readiness smoke (run_engine_smoke.py), diagnostics, etc.
reports/

# Generated audit reports and working documents (re-run tool to regenerate)
build/tools/audit_ref_coverage_report.json
build/tools/data_accuracy_report.md
build/tools/data_accuracy_report.json
build/tools/red_team_code_review.md
build/tools/content-audit-results.md
build/prompts/

# Local context is intentionally trackable in the resident repo so Gbrain and
# agents can see it. The public mirror excludes these paths
# through config/public_mirror_allowlist.json.
# Keep this one prompt out of Git until its gitleaks finding is scrubbed.
prompts/_archive/2026-06-11-0335-nsh-vol11-and-holes.md

# HuggingFace export outputs (generated — publish via upload_huggingface.py)
exports/

# Parser census and debug output files (re-run ia_schaff_herzog_census.py to regenerate)
build/parsers/*_output.txt

# Test temp directories (created by test runs, never committed)
tests/_tmp_*/

# OCR scanner reports (regenerable)
build/tools/ocr_scanner/reports/*.json
build/tools/ocr_scanner/reports/*.md
build/tools/ocr_scanner/reports/*_approved.json
# Exception: human-written review notes are committed
!build/tools/ocr_scanner/reports/*-review-notes.md

# Local scratch helpers
_run_cerebras.py

# Review subsystem (v2 plan cross-cutting requirements):
#   Committed (review work product / authorisation artefacts):
#     - review/state/**           sidecar review state
#     - review/corrections/**     correction ledger (JSONL)
#     - review/audit.jsonl        global audit log
#     - review/writer-manifests/  manifest bodies referenced by audit pointers
#   Generated, gitignored:
#     - review/*.html, review/index.html, review/.render-cache/
#     - review/producer-metrics/  per-producer metrics regenerated each run
#     - review/dead-letter/       overflow spill files; dashboard reads index
review/*.html
review/**/*.html
review/**/*-confidence.json
review/**/*-confidence.md
review/index.html
review/.render-cache/
review/producer-metrics/
review/dead-letter/

# Local context tracked in the resident repo, excluded from public mirror:
# CLAUDE.md, CLAUDE.local.md, PIPELINE_REFERENCE.md, PROJECT_*.md,
# LAST_SESSION*.md, prompts/**, plans/**, session handoff reports.
fix_api_keys.ps1
system-map.md
system-map.html
.tmp_pytest_orchestrator/
# NSH working-state notes that carry local path/identity references (keep local only)
research/2026-06-10-nsh-end-to-end-review.md
research/2026-06-11-handoff-nsh-rebuild-vol11-and-holes.md
research/2026-06-11-nsh-coverage-positioning-audit.md
research/2026-06-11-handoff-vol11-resume.md

