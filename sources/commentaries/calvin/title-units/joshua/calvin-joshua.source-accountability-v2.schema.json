{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchristiandata.org/schemas/source-to-tei/calvin-joshua-accountability-v2.schema.json",
  "title": "Calvin Joshua title-scoped source accountability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "profile_sha256",
    "crosswalk_sha256",
    "historical_container_id",
    "title",
    "selected_members",
    "included",
    "sibling_exclusions",
    "group_count",
    "component_count",
    "catalogue_title_binding"
  ],
  "properties": {
    "contract": {"const": "ocd-calvin-series-accountability-v2"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "crosswalk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "historical_container_id": {"const": "calvin-commentaries"},
    "title": {"const": "Commentary on Joshua"},
    "selected_members": {"const": ["calcom07.xml"]},
    "included": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "path", "role", "bytes", "sha256", "wrapper_sha256", "mapped_selector_count"],
        "properties": {
          "member": {"enum": ["commentaries.xml", "calcom07.xml"]},
          "path": {"type": "string"},
          "role": {"enum": ["shared-catalogue-front-matter", "primary-commentary-source"]},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "wrapper_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "mapped_selector_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "sibling_exclusions": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member", "group", "disposition"],
        "properties": {
          "member": {"type": "string", "pattern": "^calcom[0-9]{2}\\.xml$"},
          "group": {"type": "string", "minLength": 1},
          "disposition": {"const": "sibling-title-excluded-from-this-TEI"}
        }
      }
    },
    "group_count": {"const": 19},
    "component_count": {"const": 45},
    "catalogue_title_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member",
        "source_path",
        "source_sha256",
        "source_selector",
        "source_title",
        "source_title_sha256",
        "source_title_byte_offset",
        "target_selector",
        "target_text_sha256",
        "selector_convention",
        "separate_description_selector",
        "separate_description_text_sha256"
      ],
      "properties": {
        "member": {"const": "commentaries.xml"},
        "source_path": {"const": "raw/ccel/calvin-commentaries/commentaries.xml"},
        "source_sha256": {"const": "d5167554c4c40ac2ba320e9ec75afd2565001e0f5f84b0245832b7bfa183b08f"},
        "source_selector": {"const": "/ThML[1]/ThML.head[1]/electronicEdInfo[3]/DC[11]/DC.Title[1]"},
        "source_title": {"const": "Calvin's Commentaries—Complete"},
        "source_title_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_title_byte_offset": {"const": 1548},
        "target_selector": {"const": "/TEI[1]/teiHeader[1]/fileDesc[1]/sourceDesc[1]/bibl[1]/title[1]"},
        "target_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selector_convention": {"const": "all-element-child-position; not same-tag XPath indexing"},
        "separate_description_selector": {"const": "/ThML[1]/ThML.head[1]/generalInfo[1]/description[1]"},
        "separate_description_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
