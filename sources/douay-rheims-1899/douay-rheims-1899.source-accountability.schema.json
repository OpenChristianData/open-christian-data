      "required": ["books", "chapters", "verses", "facsimile_pages", "ebible_annotations", "ebible_poetry_markers", "scrollmapper_slots", "scrollmapper_empty_slots", "scrollmapper_empty_book_shells", "print_selections", "ebible_selections", "scrollmapper_selections", "print_derived_selections", "unresolved_differences", "structural_cases"],
