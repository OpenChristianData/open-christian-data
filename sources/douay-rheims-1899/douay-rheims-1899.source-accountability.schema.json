        "ebible_poetry_markers": {"const": 2528}, "scrollmapper_slots": {"const": 37255},
        "scrollmapper_empty_slots": {"const": 1450}, "scrollmapper_empty_book_shells": {"const": 5},
        "print_selections": {"const": 599}, "ebible_selections": {"const": 307},
        "scrollmapper_selections": {"const": 288}, "print_derived_selections": {"const": 4},
        "unresolved_differences": {"const": 3025}, "structural_cases": {"const": 4}
