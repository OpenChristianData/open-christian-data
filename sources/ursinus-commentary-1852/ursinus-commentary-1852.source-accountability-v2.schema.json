{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocd://sources/ursinus-commentary-1852/source-accountability-v2.schema.json",
  "title": "Ursinus 1852 retained-source accountability with scan-layout structures",
  "type": "object",
  "required": [
    "contract",
    "work_id",
    "edition_id",
    "acquisition_id",
    "one_work_one_tei",
    "source_member_hashes",
    "provider_retained_members",
    "candidate_tei",
    "leaves",
    "contents_row_map",
    "image_preserved_structures",
    "source_layout_hierarchies",
    "diagram_scan_leaves",
    "source_layout_scan_leaves",
    "source_layout_page_crosswalk",
    "unresolved_fidelity_gaps"
  ],
  "properties": {
    "contract": {"const": "ocd-ursinus-source-accountability-v2"},
    "work_id": {"const": "ursinus-commentary-heidelberg-catechism-1852"},
    "edition_id": {"const": "commdrza00ursi-1852"},
    "acquisition_id": {"const": "ia-commdrza00ursi-second-american-1852"},
    "one_work_one_tei": {
      "type": "object",
      "required": ["source_attested_complete_work_count", "candidate_tei_count", "manifest_rows"],
      "properties": {
        "source_attested_complete_work_count": {"const": 1},
        "candidate_tei_count": {"const": 1},
        "manifest_rows": {"const": ["L427", "L468"]}
      }
    },
    "source_member_hashes": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "provider_retained_members": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "candidate_tei": {
      "type": "object",
      "required": ["member", "bytes", "sha256", "root_count", "text_count", "body_division_count"],
      "properties": {
        "member": {"const": "content.tei.xml"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "root_count": {"const": 1},
        "text_count": {"const": 1},
        "body_division_count": {"const": 1}
      }
    },
    "leaves": {"type": "array", "minItems": 720, "maxItems": 720},
    "contents_row_map": {"type": "array", "minItems": 436, "maxItems": 436},
    "image_preserved_structures": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["leaf", "figure_id", "layout_type", "ocr_paragraphs"],
        "properties": {
          "leaf": {"type": "integer", "enum": [205, 489, 529, 552, 578, 613, 639]},
          "figure_id": {"type": "string"},
          "layout_type": {"enum": ["source_branch_diagram", "source_comparison_table"]},
          "ocr_paragraphs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]{3}$"}}
        }
      }
    },
    "source_layout_hierarchies": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["leaf", "layout_type", "list_type", "hierarchy_id", "source_figure_id", "node_count", "nodes", "method"],
        "properties": {
          "leaf": {"type": "integer", "enum": [205, 489, 529, 552, 578, 613, 639]},
          "layout_type": {"enum": ["source_branch_diagram", "source_comparison_table"]},
          "list_type": {"enum": ["source_diagram_brace_hierarchy", "source_table_row_pairings"]},
          "hierarchy_id": {"type": "string"},
          "source_figure_id": {"type": "string"},
          "node_count": {"type": "integer", "minimum": 1},
          "nodes": {"type": "array", "minItems": 1},
          "method": {"type": "string", "minLength": 1}
        }
      }
    },
    "diagram_scan_leaves": {"const": [205, 529, 552, 578, 613, 639]},
    "source_layout_scan_leaves": {"const": [205, 489, 529, 552, 578, 613, 639]},
    "source_layout_page_crosswalk": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["scan_leaf", "pdf_page_number", "printed_page_label"],
        "properties": {
          "scan_leaf": {"type": "integer", "enum": [205, 489, 529, 552, 578, 613, 639]},
          "pdf_page_number": {"type": "integer", "minimum": 1, "maximum": 720},
          "printed_page_label": {"type": ["string", "null"]}
        }
      }
    },
    "unresolved_fidelity_gaps": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
