            "corrected-text",
            "supplied-expansion",
            "horizontal-rule",
            "index-marker",
            "image-reference",
            "figure-description",
            "source-block",
            "word-segment",
            "source-marker",
            "table",
            "table-row",
            "table-cell",
            "person-name",
            "work-title",
            "anchor",
            "label",
            "page-furniture",
            "generator-placeholder"
          ]
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "break_mode": {
              "type": "string"
            },
            "extent": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "number": {
              "type": "string"
            },
            "place": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            },
            "certainty": {
              "type": "string"
            },
            "reference": {
              "type": "string"
            },
            "style": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "when": {
              "type": "string"
            },
            "source_target": {
              "type": "string"
            },
            "canonical_reference": {
              "type": "string"
            },
            "source_annotations": {
              "type": "string"
            },
            "subtype": {
              "type": "string"
            },
            "css_style": {
              "type": "string"
            },
            "rendition": {
              "type": "string"
            },
            "whitespace": {
              "type": "string",
              "enum": [
                "default",
                "preserve"
              ]
            },
            "columns": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "source_row_count": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "source_column_count": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "source_version": {
              "type": "string"
            },
            "source_anchor": {
              "type": "string",
              "pattern": "^Pg[A-Za-z0-9]+$"
            },
            "index_name": {
              "enum": [
                "toc",
                "pdf",
                "globalSubject"
              ]
            },
            "responsibility": {
              "type": "string"
            },
            "anchored": {
              "type": "string"
            },
            "authority_key": {
              "type": "string"
            },
            "unit": {
              "type": "string"
            },
            "source_role": {
              "type": "string"
            },
            "lemma": {
              "type": "string"
            },
            "row_span": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            }
          }
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "speech"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "contains": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "speaker"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "speaker"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ],
