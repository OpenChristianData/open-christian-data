{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocd://schemas/v2/native-content.schema.json",
  "title": "Ordered native mixed content",
  "description": "Source-native nested carriers and text/tail order; category context and private node accounting are separate.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attributes",
        "content"
      ],
      "properties": {
        "kind": {
          "enum": [
            "division",
            "paragraph",
            "heading",
            "quotation",
            "quotation-block",
            "speech",
            "speaker",
            "verse-group",
            "verse-line",
            "list",
            "list-item",
