{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchristiandata.example/schemas/lib015-source-accountability-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "ticket", "work_id", "source_sha256", "source_bytes", "physical_lines", "represented_lines", "omitted_lines", "duplicated_lines", "member_census", "excluded_members", "crosswalk_sha256", "crosswalk"],
  "properties": {
    "contract": {"const": "ocd-lib015-source-accountability-v1"},
    "ticket": {"const": "LIB-015"},
    "work_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_bytes": {"type": "integer", "minimum": 1},
    "physical_lines": {"type": "integer", "minimum": 1},
    "represented_lines": {"type": "integer", "minimum": 1},
    "omitted_lines": {"const": 0},
    "duplicated_lines": {"const": 0},
    "member_census": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256", "included", "reason"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "included": {"const": true}, "reason": {"type": "string", "minLength": 1}}}},
    "excluded_members": {"type": "array", "maxItems": 0},
    "crosswalk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "crosswalk": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "line", "byte_start", "byte_end", "record_sha256", "text_sha256", "disposition", "target"], "properties": {"id": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 1}, "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "disposition": {"const": "represented"}, "target": {"type": "string", "pattern": "^#"}}}}
  }
}
