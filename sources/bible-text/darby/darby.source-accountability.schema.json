{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchristiandata.org/schemas/source-accountability/darby-v1.schema.json",
  "title": "Darby retained-source accountability",
  "description": "Source-local carrier and exact-value ledger for the one retained Darby JSON document. This schema does not assert bibliographic identity, rights, or print completeness.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "work_id",
    "source_member",
    "source_selection",
    "translation_field",
    "counts",
    "field_states",
    "object_key_orders",
    "book_inventory",
    "chapter_inventory",
    "verse_carriers",
    "empty_text_carriers",
    "downstream_segmentation_diagnostic_only",
    "excluded"
  ],
  "properties": {
    "contract": {"const": "ocd-darby-source-accountability-v1"},
    "work_id": {"const": "darby"},
    "source_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"const": "raw/bible_databases/formats/json/Darby.json"},
        "bytes": {"const": 8515465},
        "sha256": {"const": "6e5c9816b945fa5adef7c1ba419f4ddbca5fff3f77263284697e928a0841f806"}
      }
    },
    "source_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "json_pointer", "selected_root_fields", "selection"],
      "properties": {
        "authority": {"const": "darby-source"},
        "json_pointer": {"const": ""},
        "selected_root_fields": {"const": ["/translation", "/books"]},
        "selection": {"const": "the complete single retained JSON document"}
      }
    },
    "translation_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "value", "field_state", "value_sha256"],
      "properties": {
        "json_pointer": {"const": "/translation"},
        "value": {"const": "Darby: Darby Bible (1889)"},
        "field_state": {"const": "present_nonempty_string"},
        "value_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_members",
        "books",
        "chapters",
        "verse_carriers",
        "nonempty_text_values",
        "empty_text_values",
        "missing_text_fields",
        "null_text_fields",
        "unknown_object_keys",
        "scalar_fields",
        "ordered_arrays",
        "leading_whitespace_text_values",
        "trailing_ascii_space_text_values"
      ],
      "properties": {
        "source_members": {"const": 1},
        "books": {"const": 66},
        "chapters": {"const": 1189},
        "verse_carriers": {"const": 31102},
        "nonempty_text_values": {"const": 31099},
        "empty_text_values": {"const": 3},
        "missing_text_fields": {"const": 0},
        "null_text_fields": {"const": 0},
        "unknown_object_keys": {"const": 0},
        "scalar_fields": {"const": 63460},
        "ordered_arrays": {"const": 1256},
        "leading_whitespace_text_values": {"const": 2427},
        "trailing_ascii_space_text_values": {"const": 31099}
      }
    },
    "field_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing",
        "null",
        "empty_string",
        "zero_integer",
        "false_boolean",
        "empty_array",
        "nonempty_string",
        "positive_integer"
      ],
      "properties": {
        "missing": {"const": 0},
        "null": {"const": 0},
        "empty_string": {"const": 3},
        "zero_integer": {"const": 0},
        "false_boolean": {"const": 0},
        "empty_array": {"const": 0},
        "nonempty_string": {"const": 31166},
        "positive_integer": {"const": 32291}
      }
    },
    "object_key_orders": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["shape", "keys", "occurrences"],
        "properties": {
          "shape": {"enum": ["root", "book", "chapter", "verse"]},
          "keys": {"type": "array", "items": {"type": "string"}},
          "occurrences": {"type": "integer", "minimum": 1}
        }
      }
    },
    "book_inventory": {
      "type": "array",
      "minItems": 66,
      "maxItems": 66,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["position", "name", "chapter_count", "verse_carrier_count"],
        "properties": {
          "position": {"type": "integer", "minimum": 1, "maximum": 66},
          "name": {"type": "string", "minLength": 1},
          "chapter_count": {"type": "integer", "minimum": 1},
          "verse_carrier_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "chapter_inventory": {
      "type": "array",
      "minItems": 1189,
      "maxItems": 1189,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["book_position", "book", "position", "number", "verse_carrier_count"],
        "properties": {
          "book_position": {"type": "integer", "minimum": 1, "maximum": 66},
          "book": {"type": "string", "minLength": 1},
          "position": {"type": "integer", "minimum": 1},
          "number": {"type": "integer", "minimum": 1},
          "verse_carrier_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "verse_carriers": {
      "type": "array",
      "minItems": 31102,
      "maxItems": 31102,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["json_pointer", "identity", "carrier_state", "text_field_state", "text_value_state", "text_value_sha256"],
        "properties": {
          "json_pointer": {"type": "string", "pattern": "^/books/[0-9]+/chapters/[0-9]+/verses/[0-9]+$"},
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["book_position", "book", "chapter", "verse"],
            "properties": {
              "book_position": {"type": "integer", "minimum": 1, "maximum": 66},
              "book": {"type": "string", "minLength": 1},
              "chapter": {"type": "integer", "minimum": 1},
              "verse": {"type": "integer", "minimum": 1}
            }
          },
          "carrier_state": {"const": "present"},
          "text_field_state": {"const": "present"},
          "text_value_state": {"enum": ["nonempty_string", "empty_string"]},
          "text_value_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "empty_text_carriers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "book_position", "chapter", "verse", "json_pointer", "carrier_state", "text_field_state", "text_value_state", "text_value_sha256"],
        "properties": {
          "reference": {"enum": ["Matthew 23:14", "Acts 8:37", "Acts 15:34"]},
          "book_position": {"enum": [40, 44]},
          "chapter": {"type": "integer", "minimum": 1},
          "verse": {"type": "integer", "minimum": 1},
          "json_pointer": {"type": "string", "pattern": "^/books/[0-9]+/chapters/[0-9]+/verses/[0-9]+$"},
          "carrier_state": {"const": "present"},
          "text_field_state": {"const": "present"},
          "text_value_state": {"const": "empty_string"},
          "text_value_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}
        }
      }
    },
    "downstream_segmentation_diagnostic_only": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "observed_as_of_utc_date", "observed_per_book_json_file_count", "observed_total_bytes", "observed_verse_rows", "observed_files_claiming_completeness_full", "role", "known_delta", "route_use"],
      "properties": {
        "path": {"const": "data/bible-text/darby"},
        "observed_as_of_utc_date": {"type": "string", "format": "date"},
        "observed_per_book_json_file_count": {"const": 66},
        "observed_total_bytes": {"const": 8107066},
        "observed_verse_rows": {"const": 31099},
        "observed_files_claiming_completeness_full": {"const": 66},
        "role": {"const": "diagnostic observation only; not a retained member, source selector, expected inventory, or reconstruction authority"},
        "known_delta": {"type": "string"},
        "route_use": {"type": "string"}
      }
    },
    "excluded": {"const": []}
  }
}
