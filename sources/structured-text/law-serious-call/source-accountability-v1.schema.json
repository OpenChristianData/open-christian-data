{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchristiandata.org/schemas/reconstruction/law-serious-call-source-accountability-v1.schema.json",
  "title": "Source accountability for the retained law-serious-call ThML member",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "work_id",
    "source_id",
    "source_member",
    "source_census",
    "element_counts",
    "body_element_counts",
    "ordered_divisions",
    "navigation_titles",
    "source_navigation",
    "features",
    "non_element_events",
    "unresolved_date_claims",
    "dispositions"
  ],
  "properties": {
    "contract": {"const": "ocd-law-serious-call-source-accountability-v1"},
    "work_id": {"const": "law-serious-call"},
    "source_id": {"const": "law-serious-call-retained-thml"},
    "source_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "selector", "disposition"],
      "properties": {
        "path": {"const": "raw/ccel/law/serious_call.xml"},
        "bytes": {"const": 807207},
        "sha256": {"const": "edc2bf6021f36bb7e42e1feb819c37492f920595e05ed31e22d52e7caa12c2bd"},
        "selector": {"const": "/ThML[1]"},
        "disposition": {"const": "complete-whole-retained-member"}
      }
    },
    "source_census": {
      "type": "object",
      "additionalProperties": false,
    "required": ["elements", "body_elements", "attributes", "ids", "notes", "scripture_references", "links", "internal_links", "external_links", "characters"],
      "properties": {
        "elements": {"type": "integer", "minimum": 1},
        "body_elements": {"type": "integer", "minimum": 1},
        "attributes": {"type": "integer", "minimum": 0},
        "ids": {"type": "integer", "minimum": 0},
        "notes": {"type": "integer", "minimum": 0},
        "scripture_references": {"type": "integer", "minimum": 0},
        "links": {"type": "integer", "minimum": 0},
        "internal_links": {"type": "integer", "minimum": 0},
        "external_links": {"type": "integer", "minimum": 0},
        "characters": {"type": "integer", "minimum": 0}
      }
    },
    "element_counts": {"$ref": "#/$defs/countMap"},
    "body_element_counts": {"$ref": "#/$defs/countMap"},
    "ordered_divisions": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "source_id", "source_n", "source_title", "selector", "region", "tei_type", "target_xml_id"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "source_id": {"type": "string", "minLength": 1},
          "source_n": {"type": ["string", "null"]},
          "source_title": {"type": "string", "minLength": 1},
          "selector": {"type": "string", "minLength": 1},
          "region": {"enum": ["front", "body", "back"]},
          "tei_type": {"enum": ["title-page", "chapter", "appendix", "indexes", "acknowledgments"]},
          "target_xml_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "navigation_titles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "source_id", "source_n", "source_title", "selector", "region", "tei_type", "target_xml_id", "candidate_xml_id"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "source_id": {"type": ["string", "null"]},
          "source_n": {"type": ["string", "null"]},
          "source_title": {"type": "string", "minLength": 1},
          "selector": {"type": "string", "minLength": 1},
          "region": {"type": ["string", "null"]},
          "tei_type": {"type": ["string", "null"]},
          "target_xml_id": {"type": "string", "minLength": 1},
          "candidate_xml_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "source_navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_count", "resolved_edge_count", "unresolved_edges"],
      "properties": {
        "edge_count": {"const": 62},
        "resolved_edge_count": {"const": 60},
        "unresolved_edges": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/unresolvedNavigationEdge"}
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/feature"}
    },
    "non_element_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "kind", "bytes", "sha256", "disposition"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["doctype", "comment", "pi"]},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"},
          "disposition": {"enum": ["preserved-as-tei-comment", "external-doctype-not-loaded-or-copied", "processing-instruction-accountability-only"]}
        }
      }
    },
    "unresolved_date_claims": {"type": "array", "minItems": 5, "maxItems": 5},
    "dispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unsupported_element_count", "excluded_member_count", "excluded_body_carrier_count", "date_conflict", "rights_review", "accepted_master"],
      "properties": {
        "unsupported_element_count": {"const": 0},
        "excluded_member_count": {"const": 0},
        "excluded_body_carrier_count": {"const": 0},
        "date_conflict": {"const": "unresolved"},
        "rights_review": {"const": "not-decided"},
        "accepted_master": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qname", "value"],
      "properties": {
        "qname": {"type": "string", "minLength": 1},
        "value": {"type": "string"}
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "selector", "qname", "attributes", "parent_ordinal", "child_ordinal", "text_characters", "text_sha256", "tail_characters", "tail_sha256", "disposition", "target_xml_id"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1},
        "selector": {"type": "string", "minLength": 1},
        "qname": {"type": "string", "minLength": 1},
        "attributes": {"type": "array", "items": {"$ref": "#/$defs/attribute"}},
        "parent_ordinal": {"type": ["integer", "null"], "minimum": 1},
        "child_ordinal": {"type": "integer", "minimum": 1},
        "text_characters": {"type": "integer", "minimum": 0},
        "text_sha256": {"$ref": "#/$defs/sha256"},
        "tail_characters": {"type": "integer", "minimum": 0},
        "tail_sha256": {"$ref": "#/$defs/sha256"},
        "disposition": {"enum": ["represented-by-tei-root", "represented-by-tei-text", "represented-in-tei-body", "represented-in-tei-header"]},
        "target_xml_id": {"type": ["string", "null"]}
      }
    },
    "unresolvedNavigationEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_sha256", "selector", "direction", "raw_target", "carrier_id", "disposition", "owner", "reopening_condition"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "selector": {"type": "string", "minLength": 1},
        "direction": {"enum": ["prev", "next"]},
        "raw_target": {"type": "string", "minLength": 1},
        "carrier_id": {"type": "string", "minLength": 1},
        "disposition": {"const": "source-target-absent"},
        "owner": {"type": "string", "minLength": 1},
        "reopening_condition": {"type": "string", "minLength": 1}
      }
    }
  }
}
