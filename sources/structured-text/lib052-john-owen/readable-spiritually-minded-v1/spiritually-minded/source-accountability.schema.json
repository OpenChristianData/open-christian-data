{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "member_id",
    "source",
    "root_ids_in_order",
    "root_disposition",
    "source_body_text",
    "features",
    "feature_count",
    "comments",
    "comment_count",
    "broken_local_links"
  ],
  "properties": {
    "contract": {
      "const": "ocd-owen-lib052-spiritually-minded-readable-accounting-v1"
    },
    "member_id": {
      "const": "spiritually-minded"
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ]
    },
    "root_ids_in_order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "root_disposition": {
      "type": "object",
      "required": [
        "front",
        "body",
        "back"
      ]
    },
    "source_body_text": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 3075,
      "maxItems": 3075,
      "items": {
        "type": "object",
        "required": [
          "ordinal",
          "source_tag",
          "source_attributes",
          "source_text",
          "source_tail",
          "tei_id",
          "tei_tag",
          "tei_attributes"
        ]
      }
    },
    "feature_count": {
      "const": 3075
    },
    "comments": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "required": [
          "text",
          "tail",
          "after_feature",
          "disposition"
        ]
      }
    },
    "comment_count": {
      "const": 22
    },
    "broken_local_links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 0
    }
  }
}
