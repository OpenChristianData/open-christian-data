{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchristiandata.org/sources/structured-text/bounds-essentials-of-prayer/lib031.source-accountability.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["contract", "schema", "profile_id", "source_scope", "source_reference_authority", "source_members", "document_accounting", "work_count", "feature_count", "attribute_count", "feature_counts", "omitted_feature_count", "duplicate_feature_count", "unresolved_feature_count", "crosswalk"],
  "properties": {
    "contract": {"const": "ocd-lib031-source-accountability-v1"}, "schema": {"const": "lib031.source-accountability.schema.json"}, "profile_id": {"const": "lib031-ccel-thml-cohort-v1"}, "source_scope": {"const": "each retained ThML.body represented in declared work order"},
    "source_reference_authority": {"$ref": "#/$defs/sourceAuthority"}, "source_members": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/sourceMember"}}, "document_accounting": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/document"}},
    "work_count": {"const": 10}, "feature_count": {"type": "integer", "minimum": 1}, "attribute_count": {"type": "integer", "minimum": 0}, "feature_counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}, "omitted_feature_count": {"const": 0}, "duplicate_feature_count": {"const": 0}, "unresolved_feature_count": {"const": 0}, "crosswalk": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/crosswalk"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceAuthority": {"type": "object", "additionalProperties": false, "required": ["path", "authority", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "authority": {"const": "retained-source-set"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "sourceMember": {"type": "object", "additionalProperties": false, "required": ["work_id", "path", "bytes", "sha256"], "properties": {"work_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["body_element_count", "body_attribute_count", "comment_count", "processing_instruction_count"], "properties": {"body_element_count": {"type": "integer", "minimum": 0}, "body_attribute_count": {"type": "integer", "minimum": 0}, "comment_count": {"type": "integer", "minimum": 0}, "processing_instruction_count": {"type": "integer", "minimum": 0}}},
    "document": {"type": "object", "additionalProperties": false, "required": ["work_id", "logical_path", "bytes", "sha256", "feature_count", "body_direct_text", "body_direct_text_sha256", "document_accounting", "disposition"], "properties": {"work_id": {"type": "string", "minLength": 1}, "logical_path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "feature_count": {"type": "integer", "minimum": 1}, "body_direct_text": {"type": "string"}, "body_direct_text_sha256": {"$ref": "#/$defs/sha256"}, "document_accounting": {"$ref": "#/$defs/counts"}, "disposition": {"const": "represented-as-one-work-division"}}},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "attributeDisposition": {"type": "object", "additionalProperties": false, "required": ["source_attribute", "source_value", "destination"], "properties": {"source_attribute": {"type": "string"}, "source_value": {"type": "string"}, "destination": {"enum": ["@xml:id", "projected-TEI-attribute", "source-accountability"]}}},
    "crosswalk": {"type": "object", "additionalProperties": false, "required": ["feature_id", "work_id", "source_selector", "source_tag", "source_xml_id", "attributes", "direct_text", "tail_text", "direct_text_sha256", "tail_text_sha256", "tei_tag", "tei_xml_id", "tei_parent_id", "tei_child_ordinal", "tei_attributes", "attribute_dispositions", "disposition", "tei_selector", "parent_feature_id", "source_title_head"], "properties": {
      "feature_id": {"type": "string", "pattern": "^lib031-feature-[0-9]{7}$"}, "work_id": {"type": "string", "minLength": 1}, "source_selector": {"type": "string", "minLength": 1}, "source_tag": {"type": "string", "minLength": 1}, "source_xml_id": {"type": ["string", "null"]}, "attributes": {"$ref": "#/$defs/stringMap"}, "direct_text": {"type": "string"}, "tail_text": {"type": "string"}, "direct_text_sha256": {"$ref": "#/$defs/sha256"}, "tail_text_sha256": {"$ref": "#/$defs/sha256"}, "tei_tag": {"type": "string", "minLength": 1}, "tei_xml_id": {"type": "string", "pattern": "^lib031-f-[0-9]{7}$"}, "tei_parent_id": {"type": "string"}, "tei_child_ordinal": {"type": "integer", "minimum": 1}, "tei_attributes": {"$ref": "#/$defs/stringMap"}, "attribute_dispositions": {"type": "array", "items": {"$ref": "#/$defs/attributeDisposition"}}, "disposition": {"const": "represented"}, "tei_selector": {"type": "string", "pattern": "^#lib031-f-[0-9]{7}$"}, "parent_feature_id": {"type": ["string", "null"]}, "source_title_head": {"type": ["string", "null"]}
    }}
  }
}
