{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://openchristiandata.org/sources/structured-text/bounds-essentials-of-prayer/lib031.provenance.schema.json", "type": "object", "additionalProperties": false,
  "required": ["contract", "status", "source_id", "source_member_set_sha256", "source_root", "works", "rights", "canonical_data_written", "canonical_ir_written"],
  "properties": {"contract": {"const": "ocd-lib031-provenance-v1"}, "status": {"const": "nonaccepted"}, "source_id": {"const": "ccel-lib031-retained-thml-source-set"}, "source_member_set_sha256": {"$ref": "#/$defs/sha256"}, "source_root": {"type": "string", "minLength": 1}, "works": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/work"}}, "rights": {"type": "object", "additionalProperties": false, "required": ["underlying_work_claim", "electronic_host_terms", "worldwide_rights_decision"], "properties": {"underlying_work_claim": {"const": "local-config-public-domain"}, "electronic_host_terms": {"const": "CCEL parsing permission retained as evidence"}, "worldwide_rights_decision": {"const": "unresolved"}}}, "canonical_data_written": {"const": false}, "canonical_ir_written": {"const": false}},
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "contributor": {"type": "object", "additionalProperties": false, "required": ["name", "role"], "properties": {"name": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}}}, "work": {"type": "object", "additionalProperties": false, "required": ["work_id", "title", "author", "contributors", "source_url", "source_edition", "source_sha256", "accepted_ir", "human_review", "publication"], "properties": {"work_id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "author": {"type": "string", "minLength": 1}, "contributors": {"type": "array", "items": {"$ref": "#/$defs/contributor"}}, "source_url": {"type": "string", "minLength": 1}, "source_edition": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/sha256"}, "accepted_ir": {"const": "not_accepted"}, "human_review": {"const": "required"}, "publication": {"const": "not_ready"}}}}
}
