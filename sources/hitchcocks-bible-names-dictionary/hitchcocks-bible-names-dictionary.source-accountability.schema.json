{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openchristiandata.org/schemas/hitchcocks-bible-names-dictionary-source-accountability-v1",
  "title": "Hitchcock's Bible Names Dictionary source accountability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "schema",
    "profile_id",
    "work_id",
    "source_id",
    "source_sha256",
    "source_record_count",
    "definition_block_count",
    "observation_counts",
    "crosswalk"
  ],
  "properties": {
    "contract": {
      "const": "ocd-hitchcocks-bible-names-dictionary-source-accountability-v1"
    },
    "schema": {
      "const": "sources/hitchcocks-bible-names-dictionary/hitchcocks-bible-names-dictionary.source-accountability.schema.json"
    },
    "profile_id": {
      "const": "hitchcocks-bible-names-dictionary-jwbickel-jsonl-v1"
    },
    "work_id": {
      "const": "hitchcocks-bible-names-dictionary"
    },
    "source_id": {
      "const": "jwbickel-bible-dictionaries-hitchcocks-jsonl"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_record_count": {
      "const": 2622
    },
    "definition_block_count": {
      "const": 2622
    },
    "observation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "definition_blocks",
        "total",
        "represented",
        "omitted",
        "duplicate"
      ],
      "properties": {
        "records": {
          "const": 2622
        },
        "definition_blocks": {
          "const": 2622
        },
        "total": {
          "const": 5244
        },
        "represented": {
          "const": 5244
        },
        "omitted": {
          "const": 0
        },
        "duplicate": {
          "const": 0
        }
      }
    },
    "crosswalk": {
      "type": "array",
      "minItems": 5244,
      "maxItems": 5244,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source_line",
          "source_record_sha256",
          "source_field",
          "source_index",
          "source_term",
          "value",
          "target",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "entry",
              "definition"
            ]
          },
          "source_line": {
            "type": "integer",
            "minimum": 1
          },
          "source_record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_field": {
            "enum": [
              "term",
              "definitions"
            ]
          },
          "source_index": {
            "type": "integer",
            "minimum": 0
          },
          "source_term": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "pattern": "^#[A-Za-z_][A-Za-z0-9_.-]*$"
          },
          "status": {
            "const": "represented"
          }
        }
      }
    }
  }
}
